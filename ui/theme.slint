// Tasarım belirteçleri: design/tokens-v2.json ile eşleşir.

export global Theme {
    // Vurgu rengi çalan kapaktan türetilir (Rust: art.rs), varsayılan nötr.
    in-out property <color> accent: #E4E6EB;
    out property <color> accent-soft: accent.with-alpha(0.16);
    out property <color> blob1: accent.with-alpha(0.20);
    out property <color> blob2: accent.darker(0.9).with-alpha(0.26);
    out property <color> blob3: accent.with-alpha(0.09);

    out property <color> outer: #050507;
    out property <color> canvas: #090A0D;
    out property <color> surface-subtle: #ffffff07;
    out property <color> surface-1: #ffffff0c;
    out property <color> surface-2: #ffffff14;
    out property <color> surface-3: #ffffff20;
    out property <color> floating: #13151C;
    out property <color> drawer: #101218;

    out property <color> text-primary: #F5F6F8;
    out property <color> text-secondary: #F5F6F8a3;
    out property <color> text-muted: #F5F6F861;
    out property <color> on-primary: #090A0D;

    out property <color> live: #A78BFA;
    out property <color> live-bg: #A78BFA24;

    out property <length> r-sm: 10px;
    out property <length> r-md: 14px;
    out property <length> r-lg: 20px;
    out property <length> r-xl: 26px;

    out property <length> player-height: 76px;
    out property <length> player-offset: 16px;
    out property <length> player-clearance: player-height + player-offset + 24px;

    out property <duration> micro: 140ms;
    out property <duration> card: 160ms;
    out property <duration> drawer-dur: 190ms;

    out property <string> display: "Plus Jakarta Sans";
    out property <string> sans: "Manrope";
    out property <string> mono: "JetBrains Mono";
}

