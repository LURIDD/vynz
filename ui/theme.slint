export component Icon inherits Path {
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: Theme.text-secondary;
    stroke-width: 1.4px;
    stroke-line-cap: round;
}
