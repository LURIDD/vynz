import "fonts/Manrope.ttf";
import "fonts/PlusJakartaSans.ttf";
import "fonts/JetBrainsMono.ttf";
import "fonts/InstrumentSerif-Regular.ttf";
import "fonts/InstrumentSerif-Italic.ttf";

import { Theme, Icons, Icon } from "theme.slint";
import { Track, Shelf, ImportRow, PlaylistInfo, LyricWord, LyricLine, LyricStyle, KaraokeWord, GapDots, ArtistStat, Status, Sources, SourceBadge, Fmt, Cover, EqBars, NavButton, IconButton, PillButton, Scrubber, TrackCard, TrackRow, ImportLine, Tile, MenuItem, CardUi, CardTile, MoodTile, PagerArrow } from "parts.slint";

export { Theme, Track, Shelf, ImportRow, PlaylistInfo, LyricWord, LyricLine, CardUi, ArtistStat }

// Başlıklı, sayfalı yatay raf: üzerine gelince oklar belirir, şerit kayar.
// style: 0 şarkı kartı, 1 hızlı erişim kutucuğu, 2 liste/albüm, 3 sanatçı, 4 ruh hâli
component ShelfRow inherits VerticalLayout {
    in property <Shelf> shelf;
    in property <string> now-key;
    in property <bool> wide;
    callback play(int);
    callback open(int);
    callback hover(int, bool);
    callback menu(int, length, length);

    spacing: 16px;
    Text { text: root.shelf.title; font-family: Theme.display; font-size: 21px; font-weight: 700; letter-spacing: -0.5px; color: Theme.text-primary; }
    car := Rectangle {
        property <int> style: root.shelf.style;
        property <bool> grid: style == 1 || style == 4;
        property <length> gap: grid ? 12px : 20px;
        property <int> cols: style == 1 ? (root.wide ? 4 : 2)
            : style == 4 ? (root.wide ? 5 : 3)
            : style == 3 ? Math.max(3, Math.floor((self.width + gap) / (150px + gap)))
            : Math.max(3, Math.floor((self.width + gap) / (176px + gap)));
        property <int> per-page: grid ? cols * 2 : cols;
        property <int> n: style == 0 || style == 1 ? root.shelf.items.length : root.shelf.cards.length;
        property <int> pages: Math.max(1, Math.ceil(n / per-page));
        property <int> page: 0;
        property <bool> hot;
        property <length> cell-w: (self.width - gap * (cols - 1)) / cols;
        property <length> cell-h: style == 1 ? 60px : style == 4 ? 84px : style == 3 ? cell-w + 46px : cell-w + 52px;
        height: grid ? cell-h * Math.min(2, Math.ceil(n / cols)) + gap * (n > cols ? 1 : 0) : cell-h;

        Rectangle {
            x: -12px; y: -16px; width: parent.width + 24px; height: parent.height + 40px;
            clip: true;
            Rectangle {
                x: 12px - car.page * (car.width + car.gap);
                y: 16px;
                animate x { duration: 340ms; easing: ease-in-out; }
                if car.style == 0: Rectangle {
                    for t[i] in root.shelf.items: TrackCard {
                        visible: Math.abs(Math.floor(i / car.per-page) - car.page) <= 1;
                        x: Math.floor(i / car.per-page) * (car.width + car.gap) + Math.mod(i, car.per-page) * (car.cell-w + car.gap);
                        y: 0; width: car.cell-w; height: car.cell-h;
                        track: t;
                        active: root.now-key != "" && t.key == root.now-key;
                        clicked => { root.play(i); }
                        hovered(on) => { car.hot = on; root.hover(i, on); }
                        menu(x, y) => { root.menu(i, x, y); }
                    }
                }
                if car.style == 1: Rectangle {
                    for t[i] in root.shelf.items: Tile {
                        property <int> r: Math.mod(i, car.per-page);
                        visible: Math.abs(Math.floor(i / car.per-page) - car.page) <= 1;
                        x: Math.floor(i / car.per-page) * (car.width + car.gap) + Math.mod(r, car.cols) * (car.cell-w + car.gap);
                        y: Math.floor(r / car.cols) * (car.cell-h + car.gap);
                        width: car.cell-w;
                        track: t;
                        active: root.now-key != "" && t.key == root.now-key;
                        clicked => { root.play(i); }
                        hovered(on) => { car.hot = on; root.hover(i, on); }
                        menu(x, y) => { root.menu(i, x, y); }
                    }
                }
                if car.style == 2 || car.style == 3: Rectangle {
                    for c[i] in root.shelf.cards: CardTile {
                        visible: Math.abs(Math.floor(i / car.per-page) - car.page) <= 1;
                        x: Math.floor(i / car.per-page) * (car.width + car.gap) + Math.mod(i, car.per-page) * (car.cell-w + car.gap);
                        y: 0; width: car.cell-w; height: car.cell-h;
                        card: c;
                        clicked => { root.open(i); }
                        hovered(on) => { car.hot = on; }
                    }
                }
                if car.style == 4: Rectangle {
                    for c[i] in root.shelf.cards: MoodTile {
                        property <int> r: Math.mod(i, car.per-page);
                        visible: Math.abs(Math.floor(i / car.per-page) - car.page) <= 1;
                        x: Math.floor(i / car.per-page) * (car.width + car.gap) + Math.mod(r, car.cols) * (car.cell-w + car.gap);
                        y: Math.floor(r / car.cols) * (car.cell-h + car.gap);
                        width: car.cell-w; height: car.cell-h;
                        card: c; index: i;
                        clicked => { root.open(i); }
                        hovered(on) => { car.hot = on; }
                    }
                }
            }
        }
        la := PagerArrow {
            left: true;
            x: -20px;
            y: (car.grid ? car.height : car.cell-w) / 2 - 20px;
            shown: (car.hot || self.hovering || ra.hovering) && car.page > 0;
            clicked => { car.page = Math.max(0, car.page - 1); }
        }
        ra := PagerArrow {
            left: false;
            x: car.width - 20px;
            y: (car.grid ? car.height : car.cell-w) / 2 - 20px;
            shown: (car.hot || self.hovering || la.hovering) && car.page < car.pages - 1;
            clicked => { car.page = Math.min(car.pages - 1, car.page + 1); }
        }
    }
}

// Arama: "En iyi sonuç" kartı. kind 0 şarkı, 1 albüm, 2 sanatçı, 3 liste
export struct TopResult {
    kind: int,
    title: string,
    sub: string,
    art: image,
    has-art: bool,
}

component SettingGroup inherits Rectangle {
    in property <string> title;
    in property <string> note;
    border-radius: Theme.r-lg;
    background: Theme.surface-1;
    VerticalLayout {
        padding: 22px; spacing: 10px;
        Text { text: root.title; font-size: 16px; font-weight: 700; color: Theme.text-primary; }
        Text { text: root.note; font-size: 13px; color: Theme.text-secondary; wrap: word-wrap; }
        Rectangle { height: 4px; }
        @children
    }
}

export component AppWindow inherits Window {
    in property <string> window-title: "vynz";
    title: window-title;
    forward-focus: keys;
    preferred-width: 1400px;
    preferred-height: 860px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.canvas;
    default-font-family: Theme.sans;

    // Veri (Rust doldurur)
    in property <[Shelf]> shelves;
    in property <bool> home-loading: true;
    in property <[Track]> results;
    in property <bool> searching;
    in property <bool> sc-searching;
    in property <string> last-query;
    in property <[Track]> queue;
    in property <int> queue-index: -1;
    in property <string> toast;

    // Çalan
    in property <bool> has-now;
    in property <Track> now;
    in property <bool> playing;
    in property <bool> buffering;
    in property <float> position;
    in property <float> duration;
    in-out property <float> volume: 0.8;
    property <float> muted-volume: 0.8;
    in-out property <bool> liked;

    in-out property <string> view: "home";
    in-out property <bool> drawer-open: false;
    in-out property <int> source-filter: -1;

    property <bool> compact: root.width < 1100px;
    property <length> sidebar-w: compact ? 64px : 196px;

    // Ayarlar
    in-out property <int> cache-index: 2;
    in-out property <bool> prefetch-on: true;
    in-out property <int> readahead-index: 1;
    in-out property <int> cookies-index: 0;
    in-out property <int> download-index: 1;
    in-out property <int> keep-index: 1;
    in property <string> cache-usage: "…";
    callback settings-changed();
    callback clear-cache();

    // Liste aktarma
    in property <[ImportRow]> import-rows;
    in property <bool> import-busy;
    in property <int> import-done;
    in property <int> import-total;
    in property <string> import-name;
    in property <string> import-note;
    in property <[int]> import-counts: [0, 0, 0, 0];
    in-out property <int> import-filter: -1;
    callback start-import(string);
    callback pick-file();
    // Seçilen dosyada birden çok liste varsa
    in property <[string]> file-lists;
    callback import-file-list(int);
    callback import-change(int);
    callback import-save();

    // Sözler: state 0 yok, 1 yükleniyor, 2 zamanlı, 3 zamansız, 4 bulunamadı
    in property <int> lyric-state;
    in property <[LyricLine]> lyric-lines;
    in property <int> lyric-active: -1;
    // Müzik arası ilerlemesi (0..1), yoksa -1
    in property <float> lyric-gap: -1;
    in property <[LyricWord]> lyric-row0;
    in property <[LyricWord]> lyric-row1;
    callback lyric-seek(float);
    // Açıkken saniyede ~20 kez: akıcı karaoke dolumu
    callback lyric-tick();
    // Söz görünümü ayarları (kalıcı)
    in-out property <int> lyrics-style: 0;
    in-out property <int> lyrics-size: 1;
    in-out property <int> lyrics-align: 0;
    in-out property <bool> lyrics-motion: true;
    in-out property <bool> lyrics-wide;
    callback lyrics-style-changed();
    in property <[LyricLine]> lyric-plain;
    // Çeviri: 0 kapalı, 1 Türkçe, 2 İngilizce; not ("Çevriliyor…", "Şarkı zaten Türkçe")
    in-out property <int> lyrics-translate: 0;
    in property <string> lyric-tr-note;
    callback lyrics-web-search();
    in property <string> lyric-source;
    in property <float> lyric-offset;
    in property <image> now-blur;
    in property <bool> has-blur;
    callback lyric-shift(float);

    // Kaydedilen listeler
    in property <[PlaylistInfo]> playlists;
    in property <int> current-playlist: -1;
    in property <[Track]> playlist-tracks;
    callback open-playlist(int);
    callback play-playlist(int);
    callback delete-playlist(int);

    // Ana sayfa / algoritma
    in property <string> greeting: "Merhaba";
    in property <bool> has-mix;
    // Karışım rafının sırası (kahraman kapağı için; -1 yok)
    in property <int> mix-shelf: -1;
    property <Track> hero: !has-now && mix-shelf >= 0 && mix-shelf < shelves.length && shelves[mix-shelf].items.length > 0 ? shelves[mix-shelf].items[0] : now;
    callback play-mix();
    callback refresh-home();

    // Oynatma kipleri, radyo, kuyruk
    in property <bool> shuffle-on;
    in property <int> repeat-mode;
    in property <bool> radio-busy;
    in-out property <bool> autoradio-on: true;
    callback toggle-like();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback radio-from-current();
    callback queue-remove(int);
    callback queue-move(int, int);
    callback queue-clear();

    // Sağ tık menüsü
    in-out property <bool> menu-open;
    in-out property <length> menu-x;
    in-out property <length> menu-y;
    in property <string> menu-title;
    in property <bool> menu-liked;
    callback menu-for(int, int, int);
    callback menu-action(int);

    // Kaydırma isteği (test ve ileride "başa dön" için)
    in property <length> scroll-request;
    changed scroll-request => { flick.content-y = -scroll-request; }
    // Sayfa değişince en üstten başla
    changed view => { flick.content-y = 0; root.view-changed(view); }
    callback view-changed(string);

    // Profil
    in property <string> prof-total;
    in property <string> prof-week;
    in property <int> prof-tracks-count;
    in property <int> prof-artists-count;
    in property <int> prof-likes;
    in property <[ArtistStat]> prof-top-artists;
    in property <[Track]> prof-top-tracks;
    in property <[float]> prof-hours;
    in property <string> prof-peak;
    in property <[float]> spectrum;
    in property <bool> viz-on;
    callback play-profile-track(int);

    // Söz çekmecesi (sayfa değil; öne açılır, aynı düğmeyle kapanır)
    in-out property <bool> lyrics-open;

    // Koleksiyon (liste/albüm/sanatçı) ve ruh hâli sayfaları
    callback open-card(int, int);
    in property <string> coll-title;
    in property <string> coll-sub;
    in property <int> coll-kind;
    in property <[Track]> coll-tracks;
    in property <bool> coll-loading;
    callback play-collection(int);
    callback save-collection();
    in property <string> browse-title;
    in property <[CardUi]> browse-cards;
    callback open-browse-card(int);

    // Gezinme: sayfa geçmişi (geri)
    in property <bool> can-back;
    callback go-back();
    // Sayfa değiştir: sözleri ve menüleri kapat
    public function go(v: string) {
        lyrics-open = false;
        menu-open = false;
        drawer-open = false;
        view = v;
    }

    // Arama: yazarken (gecikmeli) ve sonuç bölümleri
    callback search-edited(string);
    in property <bool> has-top;
    in property <TopResult> search-top;
    callback play-top();
    in property <[Shelf]> search-shelves;
    callback open-search-card(int, int);

    callback hover-shelf(int, int, bool);
    callback hover-result(int, bool);
    callback play-shelf(int, int);
    callback play-result(int);
    callback play-queue(int);
    callback search(string);
    callback seek(float);
    callback set-volume(float);
    callback toggle-play();
    callback next();
    callback prev();

    // Klavye kısayolları: odak arama kutusundayken yalnız Esc/Ctrl+K dinlenir.
    keys := FocusScope {
    init => { self.focus(); }
    key-pressed(e) => {
        if (e.modifiers.control && (e.text == "k" || e.text == "K")) { search-input.focus(); search-input.select-all(); return accept; }
        if (e.text == Key.Escape) {
            if (menu-open) { menu-open = false; return accept; }
            if (search-input.has-focus) { keys.focus(); return accept; }
            if (lyrics-open) { lyrics-open = false; return accept; }
            if (drawer-open) { drawer-open = false; return accept; }
            return accept;
        }
        if (search-input.has-focus) { return reject; }
        if (e.text == "/") { search-input.focus(); return accept; }
        if (e.text == " ") { root.toggle-play(); return accept; }
        if (e.modifiers.alt && e.text == Key.LeftArrow) { root.go-back(); return accept; }
        if (e.modifiers.control && e.text == Key.RightArrow) { root.next(); return accept; }
        if (e.modifiers.control && e.text == Key.LeftArrow) { root.prev(); return accept; }
        if (e.text == "l" || e.text == "L") { lyrics-open = !lyrics-open; return accept; }
        return reject;
    }

    // Kapaktan türeyen ortam ışığı
    Rectangle {
        Rectangle {
            width: root.width * 1.1; height: self.width;
            x: root.width * 0.28 - self.width / 2; y: root.height * 0.18 - self.height / 2;
            background: @radial-gradient(circle, Theme.blob1 0%, transparent 58%);
            animate background { duration: 500ms; }
        }
        Rectangle {
            width: root.width * 1.2; height: self.width;
            x: root.width * 0.76 - self.width / 2; y: root.height * 0.42 - self.height / 2;
            background: @radial-gradient(circle, Theme.blob2 0%, transparent 62%);
            animate background { duration: 500ms; }
        }
        Rectangle {
            width: root.width * 0.9; height: self.width;
            x: root.width * 0.45 - self.width / 2; y: root.height * 0.88 - self.height / 2;
            background: @radial-gradient(circle, Theme.blob3 0%, transparent 55%);
            animate background { duration: 500ms; }
        }
    }

    // ---------- Kenar çubuğu ----------
    Rectangle {
        x: 0; y: 0; width: sidebar-w; height: root.height;
        background: Theme.surface-subtle;

        VerticalLayout {
            padding: 14px; padding-top: 22px; padding-bottom: Theme.player-clearance;
            spacing: 2px;
            alignment: start;

            HorizontalLayout {
                height: 28px;
                padding-left: compact ? 0 : 10px;
                alignment: compact ? center : start;
                spacing: 10px;
                Rectangle {
                    width: 10px; height: 10px; y: 9px; border-radius: 5px;
                    background: Theme.accent;
                    drop-shadow-blur: 12px; drop-shadow-color: Theme.accent;
                }
                if !compact: Text {
                    text: "vynz"; vertical-alignment: center;
                    font-family: Theme.display; font-size: 17px; font-weight: 800;
                    letter-spacing: -0.5px; color: Theme.text-primary;
                }
            }
            Rectangle { height: 24px; }
            if !compact: Text { text: "Kütüphane"; font-size: 11px; font-weight: 700; color: Theme.text-muted; x: 12px; height: 22px; }

            NavButton { icon: Icons.home; label: "Şimdi Dinle"; compact: compact; active: view == "home"; clicked => { root.go("home"); } }
            NavButton { icon: Icons.search; label: "Ara"; compact: compact; active: view == "search"; clicked => { root.go("search"); search-input.focus(); } }
            NavButton { icon: Icons.arrows; label: "Liste Aktarma"; compact: compact; active: view == "import"; clicked => { root.go("import"); } }
            NavButton { icon: Icons.audio-lines; label: "Frekans & Profil"; compact: compact; active: view == "profile"; clicked => { root.go("profile"); } }
            NavButton { icon: Icons.settings; label: "Ayarlar"; compact: compact; active: view == "settings"; clicked => { root.go("settings"); } }

            Rectangle { height: 24px; }
            if !compact: Text { text: "Listelerim"; font-size: 11px; font-weight: 700; color: Theme.text-muted; x: 12px; height: 22px; }
            if !compact && playlists.length == 0: Text {
                text: "Liste Aktarma'dan ekle"; font-size: 12px; color: Theme.text-muted; x: 12px; height: 26px;
            }
            for p[i] in playlists: NavButton {
                icon: Icons.list-music; label: p.name; compact: compact;
                active: view == "playlist" && current-playlist == i;
                clicked => { root.open-playlist(i); root.go("playlist"); }
            }

            Rectangle { height: 24px; }
            if !compact: Text { text: "Kaynaklar"; font-size: 11px; font-weight: 700; color: Theme.text-muted; x: 12px; height: 22px; }
            for name[i] in Sources.names: HorizontalLayout {
                height: 30px;
                padding-left: compact ? 0 : 14px;
                alignment: compact ? center : start;
                spacing: 12px;
                Rectangle {
                    width: 8px; height: 8px; y: 11px; border-radius: 4px;
                    background: Sources.colors[i];
                }
                if !compact: Text {
                    text: name + (i < 2 ? "" : " · aktarma");
                    vertical-alignment: center; font-size: 12.5px;
                    color: Theme.text-secondary;
                }
            }
        }
    }

    // ---------- Ana alan ----------
    main := Rectangle {
        x: sidebar-w; y: 0; width: root.width - sidebar-w; height: root.height;

        // Üst çubuk: arama ortada, kuyruk sağda
        Rectangle {
            x: 0; y: 0; width: parent.width; height: 60px;
            Rectangle {
                width: Math.min(520px, parent.width - 260px);
                height: 40px; y: 10px;
                x: (parent.width - self.width) / 2;
                border-radius: 20px;
                background: search-input.has-focus ? Theme.surface-2 : Theme.surface-1;
                border-width: search-input.has-focus ? 1px : 0px;
                border-color: Theme.accent.with-alpha(0.5);
                animate background { duration: Theme.micro; }
                TouchArea { mouse-cursor: text; clicked => { search-input.focus(); } }
                HorizontalLayout {
                    padding-left: 16px; padding-right: 14px; spacing: 10px;
                    Icon { width: 16px; height: 16px; y: 12px; commands: Icons.search; stroke: search-input.has-focus ? Theme.text-primary : Theme.text-muted; }
                    Rectangle {
                        horizontal-stretch: 1;
                        search-input := TextInput {
                            width: parent.width; height: parent.height;
                            vertical-alignment: center;
                            font-size: 13.5px; font-weight: 500;
                            color: Theme.text-primary;
                            single-line: true;
                            edited => { root.search-edited(self.text); }
                            accepted => {
                                if (self.text != "") {
                                    root.go("search");
                                    root.search(self.text);
                                }
                                keys.focus();
                            }
                        }
                        if search-input.text == "": Text {
                            x: 0; height: parent.height; vertical-alignment: center;
                            text: "Şarkı, sanatçı, albüm ya da bağlantı";
                            font-size: 13.5px; color: Theme.text-muted;
                        }
                    }
                    Rectangle {
                        width: kb.preferred-width + 12px; height: 22px; y: 9px; border-radius: 6px;
                        background: Theme.surface-2;
                        kb := Text { text: search-input.has-focus ? "Esc" : "Ctrl K"; font-family: Theme.mono; font-size: 10.5px; color: Theme.text-muted; }
                    }
                }
            }
            Rectangle {
                width: 96px; height: 34px; y: 13px; x: parent.width - self.width - 32px;
                border-radius: 17px;
                background: drawer-open || q-ta.has-hover ? Theme.surface-2 : Theme.surface-1;
                animate background { duration: Theme.micro; }
                q-ta := TouchArea { mouse-cursor: pointer; clicked => { drawer-open = !drawer-open; } }
                HorizontalLayout {
                    x: 14px; spacing: 6px;
                    Text { text: "Kuyruk"; vertical-alignment: center; font-size: 12.5px; font-weight: 600; color: drawer-open ? Theme.text-primary : Theme.text-secondary; }
                    Text { text: queue.length; vertical-alignment: center; font-family: Theme.mono; font-size: 11px; color: Theme.text-muted; }
                }
            }
        }

        flick := Flickable {
            x: 0; y: 60px; width: parent.width; height: parent.height - 60px;
            content-width: self.width;
            content-height: content.preferred-height;

            content := VerticalLayout {
                width: flick.width;
                padding-left: 36px; padding-right: 36px; padding-top: 12px;
                padding-bottom: Theme.player-clearance + 24px;
                spacing: 36px;

                // ===== Ana sayfa =====
                if view == "home": HorizontalLayout {
                    spacing: 32px;
                    padding-top: 12px; padding-bottom: 8px;
                    Cover {
                        width: 224px; height: 224px;
                        radius: Theme.r-lg;
                        art: hero.art; has-art: hero.has-art && (has-now || has-mix);
                        drop-shadow-blur: 56px; drop-shadow-offset-y: 28px; drop-shadow-color: #000000ad;
                        TouchArea { mouse-cursor: pointer; clicked => { if (!has-now && has-mix) { root.play-mix(); } } }
                    }
                    VerticalLayout {
                        alignment: end; spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            if has-now: EqBars { y: 3px; running: playing && !buffering; }
                            Text {
                                text: !has-now ? greeting : buffering ? "Yükleniyor" : playing ? "Şimdi Çalıyor" : "Duraklatıldı";
                                font-size: 12px; font-weight: 700; color: Theme.accent;
                            }
                        }
                        Text {
                            text: has-now ? now.title : has-mix ? "Senin için karışım hazır" : "Ne dinlemek istersin?";
                            font-family: Theme.display; font-size: 60px; font-weight: 800;
                            letter-spacing: -2.4px; color: Theme.text-primary;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            if has-now: Text { text: now.artist; font-size: 15px; font-weight: 700; color: Theme.text-primary; }
                            if has-now && now.album != "": Text { text: "·"; font-size: 15px; color: Theme.text-secondary; }
                            if has-now: Text { text: now.album; font-size: 15px; font-weight: 500; color: Theme.text-secondary; overflow: elide; }
                            if !has-now: Text {
                                text: has-mix ? "Dinlediklerine göre seçildi; ne kadar dinlersen o kadar sana benzer." : "Bir şarkı seç ya da yukarıda ara; dinledikçe öneriler sana göre şekillenir.";
                                font-size: 15px; color: Theme.text-secondary;
                            }
                            if has-now: SourceBadge { y: 0px; source: now.source; }
                        }
                        Rectangle { height: 8px; }
                        HorizontalLayout {
                            spacing: 12px; alignment: start;
                            if !has-now && has-mix: PillButton { text: "Karışımı çal"; primary: true; clicked => { root.play-mix(); } }
                            if has-now: PillButton { text: lyrics-open ? "Sözleri kapat" : "Sözler"; primary: true; clicked => { lyrics-open = !lyrics-open; } }
                            if has-now: PillButton { text: radio-busy ? "Radyo hazırlanıyor…" : "Bu şarkıdan radyo"; enabled: !radio-busy; clicked => { root.radio-from-current(); } }
                            PillButton { text: "Önerileri yenile"; clicked => { root.refresh-home(); } }
                        }
                    }
                }

                if view == "home" && home-loading: Text {
                    text: "Önerilerin yükleniyor…"; font-size: 14px; color: Theme.text-secondary;
                }

                if view == "home": VerticalLayout {
                    spacing: 36px;
                    for shelf[si] in shelves: ShelfRow {
                        shelf: shelf; now-key: has-now ? now.key : ""; wide: main.width > 1150px;
                        play(i) => { root.play-shelf(si, i); }
                        open(i) => { root.open-card(si, i); }
                        hover(i, on) => { root.hover-shelf(si, i, on); }
                        menu(i, x, y) => { menu-x = x; menu-y = y; menu-open = true; root.menu-for(0, si, i); }
                    }
                }

                // ===== Koleksiyon: liste / albüm / sanatçı =====
                if view == "collection": VerticalLayout {
                    spacing: 20px;
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            horizontal-stretch: 1; spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px; alignment: start;
                                if can-back: IconButton { icon: Icons.chevron-left; tint: Theme.text-primary; clicked => { root.go-back(); } }
                                Text { text: coll-kind == 1 ? "Albüm" : coll-kind == 2 ? "Sanatçı" : "Liste"; vertical-alignment: center; font-size: 12px; font-weight: 700; color: Theme.accent; }
                            }
                            Text { text: coll-title; font-family: Theme.display; font-size: 44px; font-weight: 800; letter-spacing: -1.6px; color: Theme.text-primary; overflow: elide; }
                            Text { text: coll-loading ? "Yükleniyor…" : coll-sub + (coll-sub != "" ? " · " : "") + coll-tracks.length + " şarkı"; font-size: 14px; color: Theme.text-secondary; overflow: elide; }
                        }
                        VerticalLayout {
                            alignment: end;
                            HorizontalLayout {
                                spacing: 10px;
                                PillButton { text: "Çal"; primary: true; enabled: coll-tracks.length > 0; clicked => { root.play-collection(0); } }
                                PillButton { text: "Listelerim'e kaydet"; enabled: coll-tracks.length > 0; clicked => { root.save-collection(); } }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 0px;
                        for t[i] in coll-tracks: TrackRow {
                            track: t; index: i;
                            playing: has-now && t.key == now.key; is-running: playing && !buffering;
                            clicked => { root.play-collection(i); }
                            menu(x, y) => { menu-x = x; menu-y = y; menu-open = true; root.menu-for(4, i, 0); }
                        }
                    }
                }

                // ===== Ruh hâli / tür: listeler =====
                if view == "browse": VerticalLayout {
                    spacing: 20px;
                    VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            if can-back: IconButton { icon: Icons.chevron-left; tint: Theme.text-primary; clicked => { root.go-back(); } }
                            Text { text: "Ruh hâli ve türler"; vertical-alignment: center; font-size: 12px; font-weight: 700; color: Theme.accent; }
                        }
                        Text { text: browse-title; font-family: Theme.display; font-size: 44px; font-weight: 800; letter-spacing: -1.6px; color: Theme.text-primary; }
                    }
                    if coll-loading: Text { text: "Listeler getiriliyor…"; font-size: 14px; color: Theme.text-secondary; }
                    grid := Rectangle {
                        property <length> gap: 20px;
                        property <int> cols: Math.max(3, Math.floor((self.width + gap) / (176px + gap)));
                        property <length> cell-w: (self.width - gap * (cols - 1)) / cols;
                        height: Math.ceil(browse-cards.length / cols) * (cell-w + 52px + gap);
                        for c[i] in browse-cards: CardTile {
                            x: Math.mod(i, grid.cols) * (grid.cell-w + grid.gap);
                            y: Math.floor(i / grid.cols) * (grid.cell-w + 52px + grid.gap);
                            width: grid.cell-w; height: grid.cell-w + 52px;
                            card: c;
                            clicked => { root.open-browse-card(i); }
                        }
                    }
                }

                // ===== Arama =====
                if view == "search": VerticalLayout {
                    spacing: 30px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: last-query == "" ? "Ara" : "“" + last-query + "”";
                            font-family: Theme.display; font-size: 38px; font-weight: 800; letter-spacing: -1.4px;
                            color: Theme.text-primary; overflow: elide; horizontal-stretch: 1;
                        }
                        if searching: Text { text: "Aranıyor…"; vertical-alignment: center; font-size: 13px; color: Theme.text-secondary; }
                    }
                    if last-query == "": Text {
                        text: "Yazmaya başla; durduğunda sonuçlar gelir. Ctrl+K ya da / ile buraya, Esc ile geri.";
                        font-size: 14px; color: Theme.text-secondary;
                    }

                    // Üst bölüm: en iyi sonuç + şarkılar
                    if last-query != "": HorizontalLayout {
                        spacing: 28px;
                        // En iyi sonuç
                        VerticalLayout {
                            horizontal-stretch: 2; spacing: 14px; alignment: start;
                            Text { text: "En iyi sonuç"; font-family: Theme.display; font-size: 21px; font-weight: 700; color: Theme.text-primary; }
                            top-card := Rectangle {
                                height: 250px; border-radius: Theme.r-lg;
                                background: top-ta.has-hover ? Theme.surface-2 : Theme.surface-1;
                                animate background { duration: Theme.micro; }
                                top-ta := TouchArea { enabled: has-top; mouse-cursor: pointer; clicked => { root.play-top(); } }
                                // Yükleniyor: iskelet
                                if !has-top: Rectangle {
                                    Rectangle { x: 24px; y: 24px; width: 116px; height: 116px; border-radius: Theme.r-md; background: Theme.surface-2; }
                                    Rectangle { x: 24px; y: 162px; width: parent.width * 0.5; height: 26px; border-radius: 8px; background: Theme.surface-2; }
                                    Rectangle { x: 24px; y: 200px; width: parent.width * 0.3; height: 14px; border-radius: 7px; background: Theme.surface-2; }
                                }
                                if has-top: Rectangle {
                                    Cover {
                                        x: 24px; y: 24px; width: 116px; height: 116px;
                                        radius: search-top.kind == 2 ? 58px : Theme.r-md;
                                        art: search-top.art; has-art: search-top.has-art;
                                        drop-shadow-blur: 30px; drop-shadow-offset-y: 12px; drop-shadow-color: #00000080;
                                    }
                                    Text {
                                        x: 24px; y: 156px; width: parent.width - 120px;
                                        text: search-top.title; overflow: elide;
                                        font-family: Theme.display; font-size: 30px; font-weight: 800; letter-spacing: -1px; color: Theme.text-primary;
                                    }
                                    Rectangle {
                                        x: 24px; y: 202px; height: 24px; width: sub-t.preferred-width + 20px; border-radius: 12px; background: Theme.surface-2;
                                        sub-t := Text { text: search-top.sub; font-size: 12px; font-weight: 600; color: Theme.text-secondary; }
                                    }
                                    // Oynat düğmesi: üzerine gelince belirginleşir
                                    Rectangle {
                                        width: 56px; height: 56px; border-radius: 28px;
                                        x: parent.width - 80px;
                                        y: parent.height - (top-ta.has-hover ? 80px : 72px);
                                        opacity: top-ta.has-hover ? 1 : 0.0;
                                        animate y, opacity { duration: Theme.card; easing: ease-out; }
                                        background: Theme.accent;
                                        drop-shadow-blur: 24px; drop-shadow-offset-y: 10px; drop-shadow-color: #00000099;
                                        Icon { x: 20px; width: 20px; height: 20px; commands: search-top.kind == 0 ? Icons.play : Icons.chevron-right; stroke: Theme.on-primary; fill: search-top.kind == 0 ? Theme.on-primary : transparent; stroke-width: 2px; }
                                    }
                                }
                            }
                        }
                        // Şarkılar (ilk dört)
                        VerticalLayout {
                            horizontal-stretch: 3; spacing: 14px; alignment: start;
                            Text { text: "Şarkılar"; font-family: Theme.display; font-size: 21px; font-weight: 700; color: Theme.text-primary; }
                            if searching && results.length == 0: VerticalLayout {
                                spacing: 6px;
                                for k in 4: Rectangle {
                                    height: 56px; border-radius: Theme.r-sm; background: Theme.surface-subtle;
                                    Rectangle { x: 14px; y: 8px; width: 40px; height: 40px; border-radius: 8px; background: Theme.surface-2; }
                                    Rectangle { x: 68px; y: 14px; width: parent.width * (0.35 + 0.1 * k); height: 12px; border-radius: 6px; background: Theme.surface-2; }
                                    Rectangle { x: 68px; y: 32px; width: parent.width * 0.2; height: 10px; border-radius: 5px; background: Theme.surface-1; }
                                }
                            }
                            VerticalLayout {
                                spacing: 0px;
                                for t[i] in results: TrackRow {
                                    visible: i < 4;
                                    height: i < 4 ? 56px : 0px;
                                    track: t; index: i;
                                    playing: has-now && t.key == now.key; is-running: playing && !buffering;
                                    clicked => { root.play-result(i); }
                                    hovered(on) => { root.hover-result(i, on); }
                                    menu(x, y) => { menu-x = x; menu-y = y; menu-open = true; root.menu-for(1, i, 0); }
                                }
                            }
                            if !searching && last-query != "" && results.length == 0 && !sc-searching: Text {
                                text: "Şarkı bulunamadı. Başka bir şekilde yazmayı dene."; font-size: 14px; color: Theme.text-secondary;
                            }
                        }
                    }

                    // Albümler, sanatçılar, listeler
                    for sh[si] in search-shelves: ShelfRow {
                        shelf: sh; now-key: has-now ? now.key : ""; wide: main.width > 1150px;
                        open(i) => { root.open-search-card(si, i); }
                    }

                    // Tüm şarkılar (YouTube Music + SoundCloud)
                    if results.length > 4 || sc-searching: VerticalLayout {
                        spacing: 14px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Tüm şarkılar"; font-family: Theme.display; font-size: 21px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                            if sc-searching: Text { text: "SoundCloud aranıyor…"; vertical-alignment: center; font-size: 12.5px; color: Theme.text-muted; }
                            PillButton { pill-height: 30px; text: "Tümü"; active: source-filter == -1; clicked => { source-filter = -1; } }
                            PillButton { pill-height: 30px; text: "YouTube Music"; active: source-filter == 0; clicked => { source-filter = 0; } }
                            PillButton { pill-height: 30px; text: "SoundCloud"; active: source-filter == 1; clicked => { source-filter = 1; } }
                        }
                        VerticalLayout {
                            spacing: 0px;
                            for t[i] in results: TrackRow {
                                visible: i >= 4 && (source-filter == -1 || t.source == source-filter);
                                height: self.visible ? 56px : 0px;
                                track: t; index: i;
                                playing: has-now && t.key == now.key; is-running: playing && !buffering;
                                clicked => { root.play-result(i); }
                                hovered(on) => { root.hover-result(i, on); }
                                menu(x, y) => { menu-x = x; menu-y = y; menu-open = true; root.menu-for(1, i, 0); }
                            }
                        }
                    }
                }

                // ===== Frekans & Profil =====
                if view == "profile": VerticalLayout {
                    spacing: 24px;
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Frekans & Profil"; font-size: 12px; font-weight: 700; color: Theme.accent; }
                        Text { text: "Dinleme profilin"; font-family: Theme.display; font-size: 44px; font-weight: 800; letter-spacing: -1.6px; color: Theme.text-primary; }
                        Text { text: prof-peak; font-size: 14px; color: Theme.text-secondary; }
                    }
                    // Özet kartları
                    HorizontalLayout {
                        spacing: 14px;
                        for st in [
                            { label: "Toplam dinleme", value: prof-total },
                            { label: "Bu hafta", value: prof-week },
                            { label: "Şarkı", value: prof-tracks-count },
                            { label: "Sanatçı", value: prof-artists-count },
                            { label: "Beğeni", value: prof-likes },
                        ]: Rectangle {
                            height: 92px; border-radius: Theme.r-lg; background: Theme.surface-1;
                            VerticalLayout {
                                padding: 18px; spacing: 6px; alignment: center;
                                Text { text: st.label; font-size: 12px; font-weight: 700; color: Theme.text-muted; }
                                Text { text: st.value; font-family: Theme.display; font-size: 26px; font-weight: 800; color: Theme.text-primary; }
                            }
                        }
                    }
                    // Canlı spektrum
                    Rectangle {
                        height: 190px; border-radius: Theme.r-lg; background: Theme.surface-1; clip: true;
                        Text { x: 22px; y: 18px; text: "Canlı spektrum"; font-size: 15px; font-weight: 700; color: Theme.text-primary; }
                        Text {
                            x: 22px; y: 40px;
                            text: viz-on ? "Çalan sesin frekansları, kapağın renginde" : "Müzik çalınca burada canlanır";
                            font-size: 12.5px; color: Theme.text-secondary;
                        }
                        spec := Rectangle {
                            x: 22px; y: 70px; width: parent.width - 44px; height: parent.height - 88px;
                            property <length> bw: (self.width - 5px * 31) / 32;
                            for v[i] in spectrum: Rectangle {
                                x: i * (spec.bw + 5px); width: spec.bw;
                                height: Math.max(4px, spec.height * v);
                                y: spec.height - self.height;
                                border-radius: spec.bw / 2;
                                background: Theme.accent.with-alpha(0.55 + 0.45 * v);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 18px;
                        // En çok dinlenen sanatçılar
                        Rectangle {
                            border-radius: Theme.r-lg; background: Theme.surface-1;
                            VerticalLayout {
                                padding: 22px; spacing: 12px; alignment: start;
                                Text { text: "En çok dinlediğin sanatçılar"; font-size: 15px; font-weight: 700; color: Theme.text-primary; }
                                if prof-top-artists.length == 0: Text { text: "Henüz yok."; font-size: 13px; color: Theme.text-muted; }
                                for a in prof-top-artists: VerticalLayout {
                                    spacing: 5px;
                                    HorizontalLayout {
                                        Text { text: a.name; font-size: 13.5px; font-weight: 600; color: Theme.text-primary; overflow: elide; horizontal-stretch: 1; }
                                        Text { text: a.label; font-family: Theme.mono; font-size: 11px; color: Theme.text-muted; }
                                    }
                                    Rectangle {
                                        height: 6px; border-radius: 3px; background: Theme.surface-2;
                                        Rectangle { x: 0; width: parent.width * a.frac; height: parent.height; border-radius: 3px; background: Theme.accent; }
                                    }
                                }
                            }
                        }
                        // Günün saatleri
                        Rectangle {
                            border-radius: Theme.r-lg; background: Theme.surface-1;
                            VerticalLayout {
                                padding: 22px; spacing: 12px; alignment: start;
                                Text { text: "Günün saatlerine göre"; font-size: 15px; font-weight: 700; color: Theme.text-primary; }
                                hrs := Rectangle {
                                    height: 150px;
                                    property <length> bw: (self.width - 4px * 23) / 24;
                                    for v[i] in prof-hours: Rectangle {
                                        x: i * (hrs.bw + 4px); width: hrs.bw;
                                        height: Math.max(3px, (hrs.height - 18px) * v);
                                        y: hrs.height - 18px - self.height;
                                        border-radius: 3px;
                                        background: v > 0.99 ? Theme.accent : Theme.accent.with-alpha(0.35 + 0.5 * v);
                                    }
                                    for h[k] in ["00", "06", "12", "18"]: Text {
                                        x: k * 6 * (hrs.bw + 4px); y: hrs.height - 14px;
                                        text: h; font-family: Theme.mono; font-size: 10px; color: Theme.text-muted;
                                    }
                                }
                            }
                        }
                    }
                    if prof-top-tracks.length > 0: VerticalLayout {
                        spacing: 10px;
                        Text { text: "En çok dinlediğin şarkılar"; font-family: Theme.display; font-size: 21px; font-weight: 700; color: Theme.text-primary; }
                        VerticalLayout {
                            spacing: 0px;
                            for t[i] in prof-top-tracks: TrackRow {
                                track: t; index: i;
                                playing: has-now && t.key == now.key; is-running: playing && !buffering;
                                clicked => { root.play-profile-track(i); }
                            }
                        }
                    }
                }

                // ===== Liste aktarma =====
                if view == "import": VerticalLayout {
                    spacing: 20px;
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Liste Aktarma"; font-family: Theme.display; font-size: 44px; font-weight: 800; letter-spacing: -1.6px; color: Theme.text-primary; }
                        Text {
                            text: "Spotify, YouTube Music ya da SoundCloud liste bağlantısını yapıştır. Spotify şarkıları YouTube Music'te (bulunamazsa SoundCloud'da) eşleştirilir.";
                            font-size: 14px; color: Theme.text-secondary; wrap: word-wrap;
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            horizontal-stretch: 1; height: 44px; border-radius: 22px;
                            background: link-input.has-focus ? Theme.surface-2 : Theme.surface-1;
                            TouchArea { mouse-cursor: text; clicked => { link-input.focus(); } }
                            link-input := TextInput {
                                x: 18px; width: parent.width - 36px; height: parent.height;
                                vertical-alignment: center; single-line: true;
                                font-size: 13.5px; color: Theme.text-primary;
                                enabled: !import-busy;
                                accepted => { if (self.text != "") { root.start-import(self.text); } }
                            }
                            if link-input.text == "": Text {
                                x: 18px; height: parent.height; vertical-alignment: center;
                                text: "https://open.spotify.com/playlist/…"; font-size: 13.5px; color: Theme.text-muted;
                            }
                        }
                        PillButton {
                            pill-height: 44px; text: import-busy ? "Aktarılıyor…" : "Aktar"; primary: !import-busy; enabled: !import-busy;
                            clicked => { if (link-input.text != "") { root.start-import(link-input.text); } }
                        }
                        PillButton {
                            pill-height: 44px; text: "Dosyadan aktar"; enabled: !import-busy;
                            clicked => { root.pick-file(); }
                        }
                    }
                    if file-lists.length > 0: VerticalLayout {
                        spacing: 8px;
                        Text { text: "Dosyada birden çok liste var; aktarmak istediğini seç:"; font-size: 13px; font-weight: 600; color: Theme.text-secondary; }
                        for l[i] in file-lists: Rectangle {
                            height: 44px; border-radius: Theme.r-md;
                            background: fl-ta.has-hover ? Theme.surface-2 : Theme.surface-1;
                            fl-ta := TouchArea { mouse-cursor: pointer; clicked => { root.import-file-list(i); } }
                            HorizontalLayout {
                                padding-left: 16px; spacing: 10px;
                                Icon { y: 13px; commands: Icons.list-music; }
                                Text { text: l; vertical-alignment: center; font-size: 13.5px; font-weight: 600; color: Theme.text-primary; }
                            }
                        }
                    }
                    Text {
                        text: "Bağlantıyla Spotify'ın herkese açık listelerinden ilk 100 şarkı alınır. Gizli listeler, Beğenilen Şarkılar ve uzun listeler için: Spotify → Hesap → Gizlilik → \"Verilerini indir\"; gelen dosyadaki Playlist…json ya da YourLibrary.json'u \"Dosyadan aktar\" ile seç. Exportify / TuneMyMusic CSV dosyaları da olur.";
                        font-size: 12px; color: Theme.text-muted; wrap: word-wrap;
                    }
                    if import-busy: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: import-total > 0 ? "Eşleştiriliyor: " + import-done + " / " + import-total : "Liste okunuyor…";
                            font-size: 13px; font-weight: 600; color: Theme.text-secondary;
                        }
                        Rectangle {
                            height: 4px; border-radius: 2px; background: Theme.surface-2;
                            Rectangle {
                                x: 0; height: parent.height; border-radius: 2px; background: Theme.accent;
                                width: import-total > 0 ? parent.width * import-done / import-total : parent.width * 0.08;
                                animate width { duration: 200ms; }
                            }
                        }
                    }
                    if !import-busy && import-rows.length > 0: VerticalLayout {
                        spacing: 14px;
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: import-name; font-family: Theme.display; font-size: 22px; font-weight: 800; color: Theme.text-primary; overflow: elide; }
                                Text { text: import-note; font-size: 12.5px; color: Theme.text-secondary; overflow: elide; }
                            }
                            PillButton {
                                y: 4px; text: "Kütüphaneye kaydet (" + (import-counts[0] + import-counts[1] + import-counts[3]) + ")"; primary: true;
                                clicked => { root.import-save(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            PillButton { pill-height: 32px; text: "Tümü (" + import-rows.length + ")"; active: import-filter == -1; clicked => { import-filter = -1; } }
                            PillButton { pill-height: 32px; text: "Eşleşti (" + (import-counts[0] + import-counts[3]) + ")"; active: import-filter == 0; clicked => { import-filter = 0; } }
                            PillButton { pill-height: 32px; text: "Emin değil (" + import-counts[1] + ")"; active: import-filter == 1; clicked => { import-filter = 1; } }
                            PillButton { pill-height: 32px; text: "Bulunamadı (" + import-counts[2] + ")"; active: import-filter == 2; clicked => { import-filter = 2; } }
                        }
                        VerticalLayout {
                            spacing: 0px;
                            for r[i] in import-rows: Rectangle {
                                property <bool> shown: import-filter == -1 || r.status == import-filter || (import-filter == 0 && r.status == 3);
                                visible: shown;
                                height: shown ? 70px : 0px;
                                ImportLine {
                                    y: 0; height: 64px; line: r;
                                    change => { root.import-change(i); }
                                }
                            }
                        }
                    }
                }

                // ===== Kaydedilen liste =====
                if view == "playlist" && current-playlist >= 0 && current-playlist < playlists.length: VerticalLayout {
                    spacing: 20px;
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            horizontal-stretch: 1; spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px; alignment: start;
                                if can-back: IconButton { icon: Icons.chevron-left; tint: Theme.text-primary; clicked => { root.go-back(); } }
                                Text { text: "Liste"; vertical-alignment: center; font-size: 12px; font-weight: 700; color: Theme.accent; }
                            }
                            Text { text: playlists[current-playlist].name; font-family: Theme.display; font-size: 44px; font-weight: 800; letter-spacing: -1.6px; color: Theme.text-primary; overflow: elide; }
                            Text { text: playlists[current-playlist].count + " şarkı"; font-size: 14px; color: Theme.text-secondary; }
                        }
                        VerticalLayout {
                            alignment: end;
                            HorizontalLayout {
                                spacing: 10px;
                                PillButton { text: "Çal"; primary: true; enabled: playlist-tracks.length > 0; clicked => { root.play-playlist(0); } }
                                PillButton { text: "Sil"; clicked => { root.delete-playlist(current-playlist); view = "home"; } }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 0px;
                        for t[i] in playlist-tracks: TrackRow {
                            track: t; index: i;
                            playing: has-now && t.key == now.key; is-running: playing && !buffering;
                            clicked => { root.play-playlist(i); }
                            menu(x, y) => { menu-x = x; menu-y = y; menu-open = true; root.menu-for(2, i, 0); }
                        }
                    }
                }

                // ===== Ayarlar =====
                if view == "settings": VerticalLayout {
                    spacing: 28px;
                    Text {
                        text: "Ayarlar";
                        font-family: Theme.display; font-size: 44px; font-weight: 800; letter-spacing: -1.6px;
                        color: Theme.text-primary;
                    }

                    SettingGroup {
                        title: "Ses önbelleği";
                        note: "20 saniyeden uzun dinlenen şarkılar arka planda diske indirilir; tekrar açılışta anında başlar, internetsiz de çalar. Dolunca en uzun süredir çalınmayan silinir. Kullanılan: " + cache-usage;
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            for label[i] in ["Kapalı", "1 GB", "2 GB", "5 GB", "10 GB"]: PillButton {
                                pill-height: 32px; text: label; active: cache-index == i;
                                clicked => { cache-index = i; root.settings-changed(); }
                            }
                            Rectangle { width: 12px; }
                            PillButton { pill-height: 32px; text: "Temizle"; clicked => { root.clear-cache(); } }
                        }
                    }

                    SettingGroup {
                        title: "Dinlenmeyen şarkıları sil";
                        note: "Önbellekteki bir şarkı bu süre boyunca çalınmazsa silinir; çaldıkça süre yenilenir. Kapaklar 30 gün kullanılmazsa silinir (en çok 150 MB).";
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            for label[i] in ["14 gün", "30 gün", "90 gün", "Silme"]: PillButton {
                                pill-height: 32px; text: label; active: keep-index == i;
                                clicked => { keep-index = i; root.settings-changed(); }
                            }
                        }
                    }

                    SettingGroup {
                        title: "Arka plan indirme hızı";
                        note: "Önbelleğe indirme bu hızı aşmaz; bilgisayarda başka bir program interneti yoğun kullanıyorsa bekler, kotalı bağlantıda hiç indirmez. Çalan şarkı bu sınırdan etkilenmez.";
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            for label[i] in ["256 KB/sn", "512 KB/sn", "1 MB/sn", "Sınırsız"]: PillButton {
                                pill-height: 32px; text: label; active: download-index == i;
                                clicked => { download-index = i; root.settings-changed(); }
                            }
                        }
                    }

                    SettingGroup {
                        title: "Liste bitince";
                        note: "Kuyruk biterken çalan şarkının radyosundan (benzer şarkılar) otomatik devam edilir; atladığın şarkılar eklenmez.";
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            PillButton { pill-height: 32px; text: "Benzerleriyle devam et"; active: autoradio-on; clicked => { autoradio-on = true; root.settings-changed(); } }
                            PillButton { pill-height: 32px; text: "Dur"; active: !autoradio-on; clicked => { autoradio-on = false; root.settings-changed(); } }
                        }
                    }

                    SettingGroup {
                        title: "Önceden hazırlama";
                        note: "Sıradaki şarkılar, ekrandaki ilk şarkılar ve üzerinde beklediğin şarkı arka planda hazırlanır; tıklayınca hemen başlar. Pilde ve kotalı bağlantıda yalnız sıradakiler hazırlanır.";
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            PillButton { pill-height: 32px; text: "Açık"; active: prefetch-on; clicked => { prefetch-on = true; root.settings-changed(); } }
                            PillButton { pill-height: 32px; text: "Kapalı"; active: !prefetch-on; clicked => { prefetch-on = false; root.settings-changed(); } }
                        }
                    }

                    SettingGroup {
                        title: "İleri okuma (internet kullanımı)";
                        note: "Çalan şarkının ne kadar önden indirileceği. Kısa tutulursa ilk tampondan sonra indirme çalma hızına iner ve internet başkalarına kalır.";
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            for label[i] in ["30 sn", "1 dk", "2 dk", "Sınırsız"]: PillButton {
                                pill-height: 32px; text: label; active: readahead-index == i;
                                clicked => { readahead-index = i; root.settings-changed(); }
                            }
                        }
                    }

                    SettingGroup {
                        title: "YouTube Music girişi";
                        note: "Tarayıcıdaki YouTube oturumu kullanılırsa Premium hesaplarda ses kalitesi ~260 kbps olur; girişsiz ~140 kbps.";
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            for label[i] in ["Girişsiz", "Firefox oturumu"]: PillButton {
                                pill-height: 32px; text: label; active: cookies-index == i;
                                clicked => { cookies-index = i; root.settings-changed(); }
                            }
                        }
                    }
                }

                // ===== Henüz yapılmayan ekranlar =====
                if view != "home" && view != "search" && view != "settings" && view != "import" && view != "playlist" && view != "lyrics" && view != "collection" && view != "browse" && view != "profile": Rectangle {
                    height: 420px;
                    VerticalLayout {
                        alignment: center; spacing: 8px;
                        Text { text: "Bu ekran sonraki aşamada"; horizontal-alignment: center; font-family: Theme.display; font-size: 28px; font-weight: 800; color: Theme.text-primary; }
                        Text { text: "Şu an ana sayfa, arama ve oynatma hazır."; horizontal-alignment: center; font-size: 14px; color: Theme.text-secondary; }
                    }
                }
            }
        }
    }

    // Çekmece açıkken arkadaki sayfa görünmesin: ana alanı tamamen örten zemin.
    Rectangle {
        x: lyrics-wide ? 0 : sidebar-w; width: root.width - self.x; y: 0; height: root.height;
        background: Theme.canvas;
        opacity: lyrics-open ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: 200ms; }
        if lyrics-open: TouchArea { }
    }

    // ---------- Söz çekmecesi: öne açılır, aynı düğmeyle kapanır ----------
    lyr := Rectangle {
        property <string> fam: LyricStyle.families[lyrics-style];
        property <int> wgt: LyricStyle.weights[lyrics-style];
        property <length> fsz: LyricStyle.size(lyrics-style, lyrics-size);
        property <length> lsp: LyricStyle.spacing[lyrics-style];
        property <bool> centered: lyrics-align == 1;
        property <bool> menu: false;
        property <angle> spin: 0deg;

        x: lyrics-wide ? 16px : sidebar-w + 16px;
        width: root.width - self.x - 16px;
        animate x, width { duration: 260ms; easing: ease-out; }
        height: root.height - Theme.player-clearance - 4px;
        y: lyrics-open ? 12px : root.height + 20px;
        opacity: lyrics-open ? 1 : 0;
        animate y, opacity { duration: 260ms; easing: ease-out; }
        drop-shadow-blur: 60px; drop-shadow-offset-y: 20px; drop-shadow-color: #000000aa;
        border-radius: Theme.r-xl;

        Timer {
            interval: 50ms;
            running: lyrics-open && playing && lyric-state == 2;
            triggered => { root.lyric-tick(); }
        }

        // Hareketli zemin: bulanık kapak yavaşça döner (yalnız açıkken)
        Timer {
            interval: 8s;
            running: lyrics-open && lyrics-motion;
            triggered => { lyr.spin += 24deg; }
        }

        Rectangle {
            border-radius: Theme.r-xl;
            clip: true;
            background: Theme.canvas;
            TouchArea { clicked => { lyr.menu = false; } }

            if has-blur && has-now: Image {
                width: parent.width * 1.5; height: self.width;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                source: now-blur; image-fit: cover; opacity: 0.85;
                transform-rotation: lyr.spin;
                animate transform-rotation { duration: 8s; easing: linear; }
            }
            if has-blur && has-now && lyrics-motion: Image {
                width: parent.width * 0.9; height: self.width;
                x: parent.width * 0.55 - self.width / 2; y: parent.height * 0.6 - self.height / 2;
                source: now-blur; image-fit: cover; opacity: 0.45;
                transform-rotation: -lyr.spin * 1.6;
                animate transform-rotation { duration: 8s; easing: linear; }
            }
            // Açık kapaklarda da okunur kalsın: güçlü karartma + alt-üst gölgesi
            Rectangle { background: @linear-gradient(90deg, #090A0Df0 0%, #090A0Db8 42%, #090A0Dc8 100%); }
            Rectangle { background: @linear-gradient(180deg, #090A0D99 0%, transparent 30%, transparent 70%, #090A0Dbb 100%); }

            HorizontalLayout {
                padding: 48px; padding-right: 64px; spacing: 64px;
                // Sol: kapak ve kimlik
                VerticalLayout {
                    width: 300px; alignment: center; spacing: 16px;
                    Cover {
                        width: 300px; height: 300px; radius: Theme.r-lg;
                        art: now.art; has-art: has-now && now.has-art;
                        drop-shadow-blur: 60px; drop-shadow-offset-y: 30px; drop-shadow-color: #000000b0;
                    }
                    Text { text: has-now ? now.title : "Çalan yok"; font-family: Theme.display; font-size: 26px; font-weight: 800; letter-spacing: -0.8px; color: Theme.text-primary; overflow: elide; }
                    Text { text: has-now ? now.artist : ""; font-size: 14px; color: Theme.text-secondary; overflow: elide; }
                    if lyric-state == 2: HorizontalLayout {
                        spacing: 6px; alignment: start;
                        PillButton { pill-height: 30px; text: "−0.5 sn"; clicked => { root.lyric-shift(-0.5); } }
                        Text {
                            text: (lyric-offset > 0 ? "+" : "") + Math.round(lyric-offset * 10) / 10 + " sn";
                            vertical-alignment: center; font-family: Theme.mono; font-size: 11px; color: Theme.text-secondary; width: 56px; horizontal-alignment: center;
                        }
                        PillButton { pill-height: 30px; text: "+0.5 sn"; clicked => { root.lyric-shift(0.5); } }
                    }
                    if lyric-source != "": Text { text: "Kaynak: " + lyric-source + (lyric-state == 2 ? " · satıra tıkla, oraya atla" : ""); font-size: 11.5px; color: Theme.text-muted; }
                    if lyrics-translate > 0 && lyric-tr-note != "": Text { text: lyric-tr-note; font-size: 11.5px; color: Theme.accent; }
                }

                // Sağ: kayan söz akışı
                lview := Rectangle {
                    clip: true;
                    property <length> active-y: 0;
                    property <length> anchor: self.height * 0.4;

                    // Etkin satırın arkasında kapak renginde yumuşak ışıma
                    if lyric-state == 2: Rectangle {
                        width: lview.width * 1.1; height: lview.height * 0.7;
                        x: lyr.centered ? (lview.width - self.width) / 2 : -lview.width * 0.25;
                        y: lview.anchor - self.height / 2;
                        background: @radial-gradient(circle, Theme.accent.with-alpha(0.16) 0%, transparent 60%);
                        animate background { duration: 600ms; }
                    }
                    if lyric-state == 2: Rectangle {
                        // Etkin satır görünümün %40'ına hizalanır; liste yumuşakça kayar.
                        y: lview.anchor - lview.active-y;
                        animate y { duration: 560ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                        width: lview.width;
                        height: col.preferred-height;
                        col := VerticalLayout {
                            width: parent.width;
                            spacing: lyr.fsz * 0.55;
                            if lyric-active < 0 && lyric-gap >= 0: HorizontalLayout {
                                alignment: lyr.centered ? center : start;
                                GapDots { progress: lyric-gap; size: lyr.fsz * 0.38; }
                            }
                            for l[i] in lyric-lines: Rectangle {
                                property <bool> active: l.state == 0;
                                height: body.preferred-height;
                                changed active => { if (self.active) { lview.active-y = self.y + self.height / 2; } }
                                changed y => { if (self.active) { lview.active-y = self.y + self.height / 2; } }
                                changed height => { if (self.active) { lview.active-y = self.y + self.height / 2; } }
                                opacity: active ? 1 : l.dist == 1 ? 0.55 : l.dist == 2 ? 0.38 : l.dist <= 4 ? 0.26 : 0.14;
                                transform-scale: active ? 1.0 : 0.93;
                                transform-origin: { x: lyr.centered ? self.width / 2 : 0px, y: self.height / 2 };
                                animate opacity, transform-scale { duration: 420ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                                lt := TouchArea { mouse-cursor: pointer; clicked => { root.lyric-seek(l.t); } }
                                body := VerticalLayout {
                                    spacing: lyr.fsz * 0.15;
                                    if !active: Text {
                                        text: l.text; wrap: word-wrap;
                                        horizontal-alignment: lyr.centered ? center : left;
                                        font-family: lyr.fam; font-weight: lyr.wgt; font-size: lyr.fsz; letter-spacing: lyr.lsp;
                                        font-italic: lyrics-style == 1;
                                        color: lt.has-hover ? #FFFFFF : #FFFFFFcc;
                                    }
                                    if active: VerticalLayout {
                                        spacing: lyr.fsz * 0.12;
                                        for words in [lyric-row0, lyric-row1]: HorizontalLayout {
                                            visible: words.length > 0;
                                            height: words.length > 0 ? self.preferred-height : 0px;
                                            alignment: lyr.centered ? center : start;
                                            spacing: lyr.fsz * 0.28;
                                            for w in words: KaraokeWord {
                                                word: w; family: lyr.fam; weight: lyr.wgt; size: lyr.fsz; spacing: lyr.lsp;
                                            }
                                        }
                                    }
                                    if l.tr != "": Text {
                                        text: l.tr; wrap: word-wrap;
                                        horizontal-alignment: lyr.centered ? center : left;
                                        font-family: Theme.sans; font-weight: 500; font-size: lyr.fsz * 0.46; font-italic: true;
                                        color: active ? Theme.accent.with-alpha(0.95) : #FFFFFFaa;
                                    }
                                    if active && lyric-gap >= 0: HorizontalLayout {
                                        alignment: lyr.centered ? center : start;
                                        padding-top: lyr.fsz * 0.4;
                                        GapDots { progress: lyric-gap; size: lyr.fsz * 0.38; }
                                    }
                                }
                            }
                        }
                    }
                    if lyric-state == 3: Flickable {
                        content-height: plain.preferred-height;
                        plain := VerticalLayout {
                            spacing: 12px; alignment: start;
                            Text { text: "Bu şarkının sözleri zamanlı değil."; font-size: 12.5px; color: Theme.text-muted; }
                            for l in lyric-plain: VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: l.text; wrap: word-wrap;
                                    horizontal-alignment: lyr.centered ? center : left;
                                    font-family: lyr.fam; font-weight: lyr.wgt; font-size: lyr.fsz * 0.62; color: Theme.text-secondary;
                                }
                                if l.tr != "": Text {
                                    text: l.tr; wrap: word-wrap;
                                    horizontal-alignment: lyr.centered ? center : left;
                                    font-size: lyr.fsz * 0.36; font-italic: true; color: Theme.accent.with-alpha(0.9);
                                }
                            }
                        }
                    }
                    // Yükleniyor: nabız gibi atan satır iskeleti
                    if lyric-state == 1: VerticalLayout {
                        alignment: center; spacing: 22px;
                        property <bool> pulse;
                        Timer { interval: 700ms; running: lyrics-open; triggered => { parent.pulse = !parent.pulse; } }
                        for k in 6: Rectangle {
                            height: lyr.fsz * 0.7; border-radius: 10px;
                            width: lview.width * (k == 2 ? 0.62 : 0.32 + Math.mod(k * 37, 40) / 100);
                            x: lyr.centered ? (lview.width - self.width) / 2 : 0;
                            background: #ffffff;
                            opacity: (k == 2 ? 0.16 : 0.07) * (parent.pulse ? 1.3 : 0.8);
                            animate opacity { duration: 650ms; }
                        }
                    }
                    // Söz yok: müziğe yer açan bir sahne
                    if lyric-state == 4 || (lyric-state == 0 && has-now): VerticalLayout {
                        alignment: center; spacing: 18px;
                        // Hareketli ses çubukları (saniyede ~4 adım)
                        bars := Rectangle {
                            height: 120px;
                            property <int> tick;
                            Timer { interval: 240ms; running: lyrics-open && playing; triggered => { bars.tick += 1; } }
                            property <length> bw: 10px;
                            property <int> n: 28;
                            for i in 28: Rectangle {
                                property <float> h: Math.abs(Math.sin((bars.tick * (23 + Math.mod(i * 7, 11)) + i * 41) * 1deg));
                                x: (lyr.centered ? (lview.width - bars.n * 16px) / 2 : 0px) + i * 16px;
                                width: bars.bw; border-radius: 5px;
                                height: 12px + (playing ? 100px * h : 8px);
                                y: (bars.height - self.height) / 2;
                                background: @linear-gradient(180deg, Theme.accent 0%, Theme.accent.with-alpha(0.35) 100%);
                                animate height { duration: 230ms; easing: ease-in-out; }
                            }
                        }
                        Text {
                            text: "Bu şarkının sözleri bulunamadı";
                            horizontal-alignment: lyr.centered ? center : left;
                            font-family: lyr.fam; font-weight: lyr.wgt; font-size: 34px; letter-spacing: lyr.lsp; color: Theme.text-primary;
                        }
                        Text {
                            text: "Enstrümantal olabilir ya da söz kaynaklarında henüz yok. Arkana yaslan, müziğin tadını çıkar.";
                            wrap: word-wrap; horizontal-alignment: lyr.centered ? center : left;
                            font-size: 15px; color: Theme.text-secondary;
                        }
                        HorizontalLayout {
                            spacing: 10px; alignment: lyr.centered ? center : start;
                            PillButton { text: "Sözleri web'de ara"; primary: true; clicked => { root.lyrics-web-search(); } }
                            if queue-index + 1 < queue.length: PillButton { text: "Sıradakine geç"; clicked => { root.next(); } }
                        }
                        // Sırada ne var
                        if queue-index >= 0 && queue-index + 1 < queue.length: HorizontalLayout {
                            alignment: lyr.centered ? center : start;
                            Rectangle {
                                width: 340px; height: 72px; border-radius: Theme.r-md;
                                background: nx-ta.has-hover ? Theme.surface-2 : Theme.surface-1;
                                nx-ta := TouchArea { mouse-cursor: pointer; clicked => { root.next(); } }
                                HorizontalLayout {
                                    padding: 12px; spacing: 12px;
                                    Cover { width: 48px; height: 48px; radius: 8px; art: queue[queue-index + 1].art; has-art: queue[queue-index + 1].has-art; }
                                    VerticalLayout {
                                        alignment: center;
                                        Text { text: "Sırada"; font-size: 11px; font-weight: 700; color: Theme.accent; }
                                        Text { text: queue[queue-index + 1].title; font-size: 14px; font-weight: 700; color: Theme.text-primary; overflow: elide; }
                                        Text { text: queue[queue-index + 1].artist; font-size: 12px; color: Theme.text-secondary; overflow: elide; }
                                    }
                                }
                            }
                        }
                    }
                    // Hiçbir şey çalmıyor
                    if lyric-state == 0 && !has-now: VerticalLayout {
                        alignment: center; spacing: 16px;
                        Text {
                            text: "Bir şarkı çaldığında sözleri burada akar.";
                            horizontal-alignment: lyr.centered ? center : left;
                            font-family: lyr.fam; font-weight: lyr.wgt; font-size: 34px; color: Theme.text-primary;
                        }
                        Text { text: "Kelime kelime dolan satırlar, istersen çevirisiyle."; horizontal-alignment: lyr.centered ? center : left; font-size: 15px; color: Theme.text-secondary; }
                        HorizontalLayout {
                            alignment: lyr.centered ? center : start;
                            if has-mix: PillButton { text: "Karışımı çal"; primary: true; clicked => { root.play-mix(); } }
                        }
                    }
                }
            }

            // Sağ üst: stil, genişlet, kapat
            HorizontalLayout {
                x: parent.width - self.preferred-width - 16px; y: 16px; spacing: 6px;
                IconButton { icon: Icons.type; tint: lyr.menu ? Theme.accent : Theme.text-secondary; clicked => { lyr.menu = !lyr.menu; } }
                IconButton { icon: lyrics-wide ? Icons.shrink : Icons.expand; clicked => { lyrics-wide = !lyrics-wide; } }
                IconButton { icon: Icons.x; clicked => { lyrics-open = false; lyr.menu = false; } }
            }

            // Stil menüsü
            if lyr.menu: Rectangle {
                x: parent.width - self.width - 16px; y: 60px;
                width: 300px; height: smenu.preferred-height;
                border-radius: Theme.r-lg; background: Theme.floating;
                drop-shadow-blur: 30px; drop-shadow-offset-y: 12px; drop-shadow-color: #000000b0;
                TouchArea { }
                smenu := VerticalLayout {
                    padding: 16px; spacing: 10px;
                    Text { text: "Yazı stili"; font-size: 12px; font-weight: 700; color: Theme.text-muted; }
                    HorizontalLayout {
                        spacing: 6px;
                        for name[i] in ["Modern", "Klasik", "Sade"]: Rectangle {
                            height: 54px; border-radius: Theme.r-md;
                            background: lyrics-style == i ? Theme.surface-3 : st-ta.has-hover ? Theme.surface-2 : Theme.surface-1;
                            st-ta := TouchArea { mouse-cursor: pointer; clicked => { lyrics-style = i; root.lyrics-style-changed(); } }
                            VerticalLayout {
                                alignment: center;
                                Text { text: "Aa"; horizontal-alignment: center; font-family: LyricStyle.families[i]; font-weight: LyricStyle.weights[i]; font-size: 20px; color: Theme.text-primary; font-italic: i == 1; }
                                Text { text: name; horizontal-alignment: center; font-size: 10.5px; color: Theme.text-secondary; }
                            }
                        }
                    }
                    Text { text: "Boyut"; font-size: 12px; font-weight: 700; color: Theme.text-muted; }
                    HorizontalLayout {
                        spacing: 6px;
                        for name[i] in ["Küçük", "Orta", "Büyük"]: PillButton { pill-height: 30px; text: name; active: lyrics-size == i; clicked => { lyrics-size = i; root.lyrics-style-changed(); } }
                    }
                    Text { text: "Hizalama"; font-size: 12px; font-weight: 700; color: Theme.text-muted; }
                    HorizontalLayout {
                        spacing: 6px;
                        PillButton { pill-height: 30px; text: "Sola"; active: lyrics-align == 0; clicked => { lyrics-align = 0; root.lyrics-style-changed(); } }
                        PillButton { pill-height: 30px; text: "Ortaya"; active: lyrics-align == 1; clicked => { lyrics-align = 1; root.lyrics-style-changed(); } }
                    }
                    Text { text: "Çeviri"; font-size: 12px; font-weight: 700; color: Theme.text-muted; }
                    HorizontalLayout {
                        spacing: 6px;
                        for name[i] in ["Kapalı", "Türkçe", "English"]: PillButton { pill-height: 30px; text: name; active: lyrics-translate == i; clicked => { lyrics-translate = i; root.lyrics-style-changed(); } }
                    }
                    Text { text: "Zemin"; font-size: 12px; font-weight: 700; color: Theme.text-muted; }
                    HorizontalLayout {
                        spacing: 6px;
                        PillButton { pill-height: 30px; text: "Hareketli"; active: lyrics-motion; clicked => { lyrics-motion = true; root.lyrics-style-changed(); } }
                        PillButton { pill-height: 30px; text: "Durgun"; active: !lyrics-motion; clicked => { lyrics-motion = false; root.lyrics-style-changed(); } }
                    }
                }
            }
        }
    }

    // ---------- Kuyruk çekmecesi ----------
    Rectangle {
        width: 340px;
        y: 72px;
        height: root.height - 72px - Theme.player-clearance + 12px;
        x: drawer-open ? root.width - self.width - 16px : root.width + 24px;
        opacity: drawer-open ? 1 : 0;
        animate x, opacity { duration: Theme.drawer-dur; easing: ease-out; }
        border-radius: Theme.r-lg;
        background: Theme.drawer;
        drop-shadow-blur: 48px; drop-shadow-offset-x: -20px; drop-shadow-color: #00000099;
        clip: true;

        TouchArea { }

        VerticalLayout {
            padding: 20px; spacing: 10px;
            HorizontalLayout {
                Text { text: "Kuyruk"; font-family: Theme.display; font-size: 17px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                IconButton { icon: Icons.x; clicked => { drawer-open = false; } }
            }
            HorizontalLayout {
                spacing: 6px; alignment: start;
                PillButton { pill-height: 30px; text: radio-busy ? "Radyo…" : "Radyo başlat"; enabled: has-now && !radio-busy; clicked => { root.radio-from-current(); } }
                PillButton { pill-height: 30px; text: "Temizle"; enabled: queue.length > 1; clicked => { root.queue-clear(); } }
            }
            if queue.length == 0: Text { text: "Kuyruk boş."; font-size: 13px; color: Theme.text-secondary; }
            Flickable {
                content-height: qlist.preferred-height;
                qlist := VerticalLayout {
                    spacing: 6px; alignment: start;
                    for t[i] in queue: Rectangle {
                        height: 56px; border-radius: Theme.r-sm;
                        background: i == queue-index ? Theme.surface-2 : qi-ta.has-hover ? Theme.surface-1 : Theme.surface-subtle;
                        animate background { duration: Theme.micro; }
                        qi-ta := TouchArea { mouse-cursor: pointer; clicked => { root.play-queue(i); } }
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 8px; spacing: 10px;
                            Cover { width: 38px; height: 38px; y: 9px; radius: 7px; art: t.art; has-art: t.has-art; }
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 1;
                                Text { text: t.title; font-size: 13.5px; font-weight: 600; color: i == queue-index ? Theme.accent : Theme.text-primary; overflow: elide; }
                                Text { text: t.artist; font-size: 12px; color: Theme.text-secondary; overflow: elide; }
                            }
                            IconButton { y: 11px; icon: Icons.chevron-up; tint: Theme.text-muted; enabled: i > 0; clicked => { root.queue-move(i, -1); } }
                            IconButton { y: 11px; icon: Icons.chevron-down; tint: Theme.text-muted; enabled: i < queue.length - 1; clicked => { root.queue-move(i, 1); } }
                            IconButton { y: 11px; icon: Icons.x; tint: Theme.text-muted; clicked => { root.queue-remove(i); } }
                        }
                    }
                }
            }
        }
    }

    // ---------- Bildirim ----------
    if toast != "": Rectangle {
        y: root.height - Theme.player-clearance - 12px;
        x: (root.width - self.width) / 2;
        width: tt.preferred-width + 32px; height: 36px;
        border-radius: 18px; background: Theme.surface-3;
        tt := Text { text: toast; font-size: 13px; font-weight: 600; color: Theme.text-primary; }
    }

    // ---------- Yüzen oynatma çubuğu ----------
    Rectangle {
        x: 20px; width: root.width - 40px;
        height: Theme.player-height;
        y: root.height - self.height - Theme.player-offset;
        border-radius: Theme.r-lg;
        background: Theme.floating;
        drop-shadow-blur: 48px; drop-shadow-offset-y: 24px; drop-shadow-color: #000000b8;

        TouchArea { }

        HorizontalLayout {
            x: 20px; width: 290px; spacing: 14px; alignment: start;
            Cover {
                width: 44px; height: 44px; y: (Theme.player-height - 44px) / 2;
                radius: Theme.r-sm;
                art: now.art; has-art: has-now && now.has-art;
            }
            VerticalLayout {
                alignment: center;
                Text { text: has-now ? now.title : "Çalan yok"; font-size: 14px; font-weight: 700; color: Theme.text-primary; overflow: elide; }
                Text { text: has-now ? now.artist : "—"; font-size: 12.5px; color: Theme.text-secondary; overflow: elide; }
            }
            IconButton {
                y: (Theme.player-height - self.height) / 2;
                icon: Icons.heart; tint: liked ? Theme.accent : Theme.text-secondary; filled: liked;
                enabled: has-now;
                clicked => { root.toggle-like(); }
            }
        }

        VerticalLayout {
            x: (parent.width - self.width) / 2; width: Math.min(560px, parent.width - 640px);
            alignment: center; spacing: 4px;
            HorizontalLayout {
                alignment: center; spacing: 10px;
                IconButton { icon: Icons.shuffle; y: 3px; enabled: has-now; tint: shuffle-on ? Theme.accent : Theme.text-secondary; clicked => { root.toggle-shuffle(); } }
                IconButton { icon: Icons.skip-back; y: 3px; enabled: has-now; clicked => { root.prev(); } }
                IconButton { icon: playing ? Icons.pause : Icons.play; primary: true; enabled: has-now; clicked => { root.toggle-play(); } }
                IconButton { icon: Icons.skip-forward; y: 3px; enabled: has-now; clicked => { root.next(); } }
                Rectangle {
                    width: 34px; height: 34px; y: 3px;
                    IconButton { icon: Icons.repeat; enabled: has-now; tint: repeat-mode > 0 ? Theme.accent : Theme.text-secondary; clicked => { root.cycle-repeat(); } }
                    if repeat-mode == 2: Text { x: 23px; y: 2px; text: "1"; font-size: 9px; font-weight: 800; color: Theme.accent; }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Text {
                    // Sürüklerken gidilecek yeri göster
                    text: Fmt.time(prog.dragging ? prog.shown * duration : position);
                    vertical-alignment: center; font-family: Theme.mono; font-size: 11px;
                    color: prog.dragging ? Theme.text-primary : Theme.text-muted;
                }
                prog := Scrubber {
                    horizontal-stretch: 1;
                    enabled: has-now && duration > 0;
                    value: duration > 0 ? position / duration : 0;
                    seek(f) => { root.seek(f * duration); }
                }
                Text { text: Fmt.time(duration); vertical-alignment: center; font-family: Theme.mono; font-size: 11px; color: Theme.text-muted; }
            }
        }

        HorizontalLayout {
            x: parent.width - self.width - 20px; width: 290px;
            alignment: end; spacing: 6px;
            IconButton { y: (Theme.player-height - self.height) / 2; icon: Icons.mic; tint: lyrics-open ? Theme.accent : Theme.text-secondary; clicked => { lyrics-open = !lyrics-open; } }
            IconButton { y: (Theme.player-height - self.height) / 2; icon: Icons.list-music; tint: drawer-open ? Theme.accent : Theme.text-secondary; clicked => { drawer-open = !drawer-open; } }
            // Hoparlör: tıkla = sessize al / geri aç; tekerlek = ses
            Rectangle {
                width: 30px; height: 30px; y: (Theme.player-height - self.height) / 2;
                border-radius: 15px;
                background: vol-ta.has-hover ? Theme.surface-2 : transparent;
                vol-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (volume > 0.001) { root.muted-volume = volume; volume = 0; }
                        else { volume = root.muted-volume > 0.001 ? root.muted-volume : 0.5; }
                        root.set-volume(volume);
                    }
                    scroll-event(e) => {
                        volume = Math.clamp(volume + (e.delta-y > 0 ? 0.05 : -0.05), 0, 1);
                        root.set-volume(volume);
                        return accept;
                    }
                }
                Icon { commands: volume < 0.001 ? Icons.volume-x : Icons.volume; stroke: vol-ta.has-hover ? Theme.text-primary : Theme.text-secondary; }
            }
            Scrubber {
                width: 84px; y: (Theme.player-height - self.height) / 2;
                live: true; wheel: true;
                value: volume;
                seek(f) => { volume = f; root.set-volume(f); }
            }
        }
    }

    // ---------- Sağ tık menüsü ----------
    if menu-open: TouchArea {
        // dışarı tıklayınca kapan
        clicked => { menu-open = false; }
        pointer-event(e) => { if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) { menu-open = false; } }
    }
    if menu-open: Rectangle {
        width: 220px;
        height: mcol.preferred-height;
        x: Math.min(menu-x, root.width - self.width - 8px);
        y: Math.min(menu-y, root.height - self.height - 8px);
        border-radius: Theme.r-md;
        background: Theme.floating;
        drop-shadow-blur: 30px; drop-shadow-offset-y: 12px; drop-shadow-color: #000000b0;
        TouchArea { }
        mcol := VerticalLayout {
            padding: 6px; spacing: 0px;
            Text { text: menu-title; font-size: 11.5px; font-weight: 700; color: Theme.text-muted; overflow: elide; height: 26px; vertical-alignment: center; x: 10px; width: 196px; }
            MenuItem { icon: Icons.play; text: "Şimdi çal"; clicked => { root.menu-action(0); } }
            MenuItem { icon: Icons.list-start; text: "Sıradaki çal"; clicked => { root.menu-action(1); } }
            MenuItem { icon: Icons.list-plus; text: "Kuyruğa ekle"; clicked => { root.menu-action(2); } }
            MenuItem { icon: Icons.radio; text: "Radyo başlat"; clicked => { root.menu-action(3); } }
            MenuItem { icon: Icons.heart; text: menu-liked ? "Beğenmekten vazgeç" : "Beğen"; clicked => { root.menu-action(4); } }
        }
    }
    }
}
