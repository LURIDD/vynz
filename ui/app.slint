import "fonts/Manrope.ttf";
import "fonts/PlusJakartaSans.ttf";
import "fonts/JetBrainsMono.ttf";

import { Theme, Icons, Icon } from "theme.slint";
import { Album, Track, Fmt, Cover, EqBars, NavButton, IconButton, PillButton, Scrubber, AlbumCard, TrackRow } from "parts.slint";

export { Theme, Album, Track }

export component AppWindow inherits Window {
    title: "vynz";
    preferred-width: 1400px;
    preferred-height: 860px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.canvas;
    default-font-family: Theme.sans;

    in property <[Album]> albums;
    in property <[Track]> tracks;
    in property <[Track]> queue;
    in-out property <int> now-index: 0;
    in-out property <bool> playing: true;
    in-out property <float> position: 134;
    in-out property <float> volume: 0.8;
    in-out property <bool> liked: true;
    in-out property <string> view: "home";
    in-out property <bool> drawer-open: false;

    property <Track> now: tracks[now-index];
    property <bool> compact: root.width < 1100px;
    property <length> sidebar-w: compact ? 64px : 196px;

    callback play-track(int);
    callback seek(float);
    callback toggle-play();
    callback next();
    callback prev();

    // Kapaktan türeyen ortam ışığı (Rust tarafında 64x64 bulanık kapak dokusuyla değişecek)
    ambient := Rectangle {
        Rectangle {
            width: root.width * 1.1; height: self.width;
            x: root.width * 0.28 - self.width / 2; y: root.height * 0.18 - self.height / 2;
            background: @radial-gradient(circle, Theme.blob1 0%, transparent 58%);
            animate background { duration: 400ms; }
        }
        Rectangle {
            width: root.width * 1.2; height: self.width;
            x: root.width * 0.76 - self.width / 2; y: root.height * 0.42 - self.height / 2;
            background: @radial-gradient(circle, Theme.blob2 0%, transparent 62%);
            animate background { duration: 400ms; }
        }
        Rectangle {
            width: root.width * 0.9; height: self.width;
            x: root.width * 0.45 - self.width / 2; y: root.height * 0.88 - self.height / 2;
            background: @radial-gradient(circle, Theme.blob3 0%, transparent 55%);
            animate background { duration: 400ms; }
        }
    }

    // ---------- Kenar çubuğu ----------
    sidebar := Rectangle {
        x: 0; y: 0; width: sidebar-w; height: root.height;
        background: Theme.surface-subtle;
        animate width { duration: Theme.drawer-dur; easing: ease-out; }

        VerticalLayout {
            padding: 14px; padding-top: 22px; padding-bottom: Theme.player-clearance;
            spacing: 2px;
            alignment: start;

            HorizontalLayout {
                height: 28px;
                padding-left: compact ? 0 : 10px;
                alignment: compact ? center : start;
                spacing: 10px;
                Rectangle {
                    width: 10px; height: 10px; y: 9px; border-radius: 5px;
                    background: Theme.accent;
                    drop-shadow-blur: 12px; drop-shadow-color: Theme.accent;
                    animate background { duration: 200ms; }
                }
                if !compact: Text {
                    text: "vynz"; vertical-alignment: center;
                    font-family: Theme.display; font-size: 17px; font-weight: 800;
                    letter-spacing: -0.5px; color: Theme.text-primary;
                }
            }
            Rectangle { height: 24px; }
            if !compact: Text { text: "Kütüphane"; font-size: 11px; font-weight: 700; color: Theme.text-muted; x: 12px; height: 22px; }

            NavButton { icon: Icons.home; label: "Şimdi Dinle"; compact: compact; active: view == "home"; clicked => { view = "home"; } }
            NavButton { icon: Icons.disc; label: "Albümler"; compact: compact; active: view == "album"; clicked => { view = "album"; } }
            NavButton { icon: Icons.mic; label: "Söz Vitrini"; compact: compact; active: view == "lyrics"; clicked => { view = "lyrics"; } }
            NavButton { icon: Icons.arrows; label: "Liste Aktarma"; compact: compact; active: view == "import"; clicked => { view = "import"; } }
            NavButton { icon: Icons.radio; label: "Dinleme Odası"; compact: compact; dot: true; active: view == "room"; clicked => { view = "room"; } }
            NavButton { icon: Icons.audio-lines; label: "Frekans & Profil"; compact: compact; active: view == "profile"; clicked => { view = "profile"; } }
            NavButton { icon: Icons.settings; label: "Ayarlar"; compact: compact; active: view == "settings"; clicked => { view = "settings"; } }

            Rectangle { height: 24px; }
            if !compact: Text { text: "Koleksiyonlar"; font-size: 11px; font-weight: 700; color: Theme.text-muted; x: 12px; height: 22px; }
            NavButton { icon: Icons.list-music; label: "Anadolu Psikedelik"; compact: compact; }
            NavButton { icon: Icons.list-music; label: "Gece Sürüşü"; compact: compact; }
            NavButton { icon: Icons.list-music; label: "Referans Kayıtlar"; compact: compact; }
        }
    }

    // ---------- Ana alan ----------
    main := Rectangle {
        x: sidebar-w; y: 0; width: root.width - sidebar-w; height: root.height;

        // Üst çubuk
        Rectangle {
            x: 0; y: 0; width: parent.width; height: 60px;
            HorizontalLayout {
                padding-left: 32px; padding-right: 32px; spacing: 10px;
                Rectangle {
                    width: Math.min(360px, main.width * 0.4);
                    height: 38px; y: 11px;
                    border-radius: 19px;
                    background: search-input.has-focus ? Theme.surface-2 : Theme.surface-1;
                    animate background { duration: Theme.micro; }
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 10px;
                        Icon { width: 15px; height: 15px; y: (38px - 15px) / 2; commands: Icons.search; stroke: Theme.text-muted; }
                        search-input := TextInput {
                            vertical-alignment: center;
                            font-size: 13.5px; font-weight: 500;
                            color: Theme.text-primary;
                            text: "Erkin Koray";
                            single-line: true;
                        }
                        Text { text: "Ctrl K"; vertical-alignment: center; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                // Canlı oda
                Rectangle {
                    min-width: room-label.preferred-width + 42px; max-width: self.min-width; height: 34px; y: 13px;
                    border-radius: 17px; background: Theme.live-bg;
                    room-ta := TouchArea { mouse-cursor: pointer; clicked => { view = "room"; } }
                    opacity: room-ta.has-hover ? 0.88 : 1;
                    Rectangle {
                        x: 14px; width: 7px; height: 7px; border-radius: 3.5px; background: Theme.live;
                        drop-shadow-blur: 8px; drop-shadow-color: Theme.live;
                    }
                    room-label := Text {
                        x: 30px; text: "#stüdyo-gece · 4 dinleyici";
                        font-size: 12.5px; font-weight: 700; color: Theme.live;
                    }
                }
                // Kuyruk düğmesi
                Rectangle {
                    min-width: 96px; max-width: 96px; height: 34px; y: 13px;
                    border-radius: 17px;
                    background: drawer-open || q-ta.has-hover ? Theme.surface-2 : Theme.surface-1;
                    animate background { duration: Theme.micro; }
                    q-ta := TouchArea { mouse-cursor: pointer; clicked => { drawer-open = !drawer-open; } }
                    q-row := HorizontalLayout {
                        x: 14px; spacing: 6px;
                        Text { text: "Kuyruk"; vertical-alignment: center; font-size: 12.5px; font-weight: 600; color: drawer-open ? Theme.text-primary : Theme.text-secondary; }
                        Text { text: queue.length; vertical-alignment: center; font-family: Theme.mono; font-size: 11px; color: Theme.text-muted; }
                    }
                }
            }
        }

        // Kaydırılan içerik
        flick := Flickable {
            x: 0; y: 60px; width: parent.width; height: parent.height - 60px;
            content-width: self.width;
            content-height: content.preferred-height;

            content := VerticalLayout {
                width: flick.width;
                padding-left: 36px; padding-right: 36px; padding-top: 12px;
                padding-bottom: Theme.player-clearance + 24px;
                spacing: 36px;

                if view != "home": Rectangle {
                    height: 420px;
                    VerticalLayout {
                        alignment: center; spacing: 8px;
                        Text { text: "Bu ekran sonraki aşamada"; horizontal-alignment: center; font-family: Theme.display; font-size: 28px; font-weight: 800; color: Theme.text-primary; }
                        Text { text: "1. aşamada yalnız ana sayfa ve oynatma çubuğu var."; horizontal-alignment: center; font-size: 14px; color: Theme.text-secondary; }
                    }
                }

                // Kahraman: çalan şarkı
                if view == "home": HorizontalLayout {
                    spacing: 32px;
                    padding-top: 12px; padding-bottom: 8px;
                    hero-cover := Cover {
                        width: 224px; height: 224px;
                        radius: Theme.r-lg;
                        album: albums[now.cover];
                        drop-shadow-blur: 56px; drop-shadow-offset-y: 28px; drop-shadow-color: #000000ad;
                    }
                    VerticalLayout {
                        alignment: end; spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            EqBars { y: 3px; running: playing; }
                            Text { text: playing ? "Şimdi Çalıyor" : "Duraklatıldı"; font-size: 12px; font-weight: 700; color: Theme.accent; }
                        }
                        Text {
                            text: now.title;
                            font-family: Theme.display; font-size: 64px; font-weight: 800;
                            letter-spacing: -2.5px; color: Theme.text-primary;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            Text { text: now.artist; font-size: 15px; font-weight: 700; color: Theme.text-primary; }
                            Text { text: "·"; font-size: 15px; color: Theme.text-secondary; }
                            Text { text: now.album; font-size: 15px; font-weight: 500; color: Theme.text-secondary; }
                        }
                        Rectangle { height: 8px; }
                        HorizontalLayout {
                            spacing: 12px; alignment: start;
                            PillButton { text: "Söz Vitrinini Aç"; primary: true; clicked => { view = "lyrics"; } }
                            PillButton { text: "Albüme Git"; clicked => { view = "album"; } }
                        }
                    }
                }

                // Son dinlenen albümler
                if view == "home": VerticalLayout {
                    spacing: 16px;
                    Text { text: "Son Dinlenen Albümler"; font-family: Theme.display; font-size: 21px; font-weight: 700; letter-spacing: -0.5px; color: Theme.text-primary; }
                    grid := Rectangle {
                        property <int> cols: albums.length;
                        property <length> gap: 20px;
                        property <length> card-w: (self.width - gap * (cols - 1)) / cols;
                        height: card-w + 56px;
                        for a[i] in albums: AlbumCard {
                            x: i * (grid.card-w + grid.gap); y: 0;
                            width: grid.card-w; height: grid.card-w + 56px;
                            album: a;
                            clicked => { root.play-track(i); }
                        }
                    }
                }

                // Son çalınanlar
                if view == "home": VerticalLayout {
                    spacing: 14px;
                    Text { text: "Son Çalınanlar"; font-family: Theme.display; font-size: 21px; font-weight: 700; letter-spacing: -0.5px; color: Theme.text-primary; }
                    VerticalLayout {
                        spacing: 2px;
                        for t[i] in tracks: TrackRow {
                            track: t; index: i;
                            playing: i == now-index; is-running: playing;
                            clicked => { root.play-track(i); }
                        }
                    }
                }
            }
        }
    }

    // ---------- Kuyruk çekmecesi (varsayılan kapalı, kayarak gelir) ----------
    drawer := Rectangle {
        width: 328px;
        y: 72px;
        height: root.height - 72px - Theme.player-clearance + 12px;
        x: drawer-open ? root.width - self.width - 16px : root.width + 24px;
        opacity: drawer-open ? 1 : 0;
        animate x, opacity { duration: Theme.drawer-dur; easing: ease-out; }
        border-radius: Theme.r-lg;
        background: Theme.drawer;
        drop-shadow-blur: 48px; drop-shadow-offset-x: -20px; drop-shadow-color: #00000099;

        TouchArea { } // altına tıklama geçmesin

        VerticalLayout {
            padding: 20px; spacing: 10px; alignment: start;
            HorizontalLayout {
                Text { text: "Sıradakiler"; font-family: Theme.display; font-size: 17px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                IconButton { icon: Icons.x; clicked => { drawer-open = false; } }
            }
            for t[i] in queue: Rectangle {
                height: 52px; border-radius: Theme.r-sm;
                background: qi-ta.has-hover ? Theme.surface-1 : Theme.surface-subtle;
                animate background { duration: Theme.micro; }
                qi-ta := TouchArea { mouse-cursor: pointer; }
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Text { text: t.title; font-size: 13.5px; font-weight: 600; color: Theme.text-primary; overflow: elide; }
                        Text { text: t.artist; font-size: 12px; color: Theme.text-secondary; overflow: elide; }
                    }
                    Text { text: Fmt.time(t.duration); vertical-alignment: center; font-family: Theme.mono; font-size: 11px; color: Theme.text-muted; horizontal-alignment: right; }
                }
            }
        }
    }

    // ---------- Yüzen oynatma çubuğu ----------
    player := Rectangle {
        x: 20px; width: root.width - 40px;
        height: Theme.player-height;
        y: root.height - self.height - Theme.player-offset;
        border-radius: Theme.r-lg;
        background: Theme.floating;
        drop-shadow-blur: 48px; drop-shadow-offset-y: 24px; drop-shadow-color: #000000b8;

        TouchArea { }

        // Sol: çalan şarkı
        HorizontalLayout {
            x: 20px; width: 290px; spacing: 14px; alignment: start;
            Cover {
                width: 44px; height: 44px; y: (Theme.player-height - 44px) / 2;
                radius: Theme.r-sm;
                album: albums[now.cover];
            }
            VerticalLayout {
                alignment: center;
                Text { text: now.title; font-size: 14px; font-weight: 700; color: Theme.text-primary; overflow: elide; }
                Text { text: now.artist; font-size: 12.5px; color: Theme.text-secondary; overflow: elide; }
            }
            IconButton {
                y: (Theme.player-height - self.height) / 2;
                icon: Icons.heart; tint: liked ? Theme.accent : Theme.text-secondary;
                clicked => { liked = !liked; }
            }
        }

        // Orta: kontroller ve ilerleme
        VerticalLayout {
            x: (parent.width - self.width) / 2; width: Math.min(560px, parent.width - 640px);
            alignment: center; spacing: 4px;
            HorizontalLayout {
                alignment: center; spacing: 10px;
                IconButton { icon: Icons.shuffle; y: 3px; }
                IconButton { icon: Icons.skip-back; y: 3px; clicked => { root.prev(); } }
                IconButton { icon: playing ? Icons.pause : Icons.play; primary: true; clicked => { root.toggle-play(); } }
                IconButton { icon: Icons.skip-forward; y: 3px; clicked => { root.next(); } }
                IconButton { icon: Icons.repeat; y: 3px; }
            }
            HorizontalLayout {
                spacing: 12px;
                Text { text: Fmt.time(position); vertical-alignment: center; font-family: Theme.mono; font-size: 11px; color: Theme.text-muted; }
                Scrubber {
                    horizontal-stretch: 1;
                    value: now.duration > 0 ? position / now.duration : 0;
                    seek(f) => { root.seek(f); }
                }
                Text { text: Fmt.time(now.duration); vertical-alignment: center; font-family: Theme.mono; font-size: 11px; color: Theme.text-muted; }
            }
        }

        // Sağ: araçlar ve ses
        HorizontalLayout {
            x: parent.width - self.width - 20px; width: 290px;
            alignment: end; spacing: 6px;
            IconButton { y: (Theme.player-height - self.height) / 2; icon: Icons.mic; clicked => { view = "lyrics"; } }
            IconButton { y: (Theme.player-height - self.height) / 2; icon: Icons.list-music; tint: drawer-open ? Theme.accent : Theme.text-secondary; clicked => { drawer-open = !drawer-open; } }
            IconButton { y: (Theme.player-height - self.height) / 2; icon: Icons.pip; }
            Icon { y: (Theme.player-height - self.height) / 2; commands: Icons.volume; }
            Scrubber {
                width: 64px; y: (Theme.player-height - self.height) / 2;
                value: volume;
                seek(f) => { volume = f; }
            }
        }
    }
}
