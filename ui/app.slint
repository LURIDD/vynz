import "fonts/Manrope.ttf";
import "fonts/PlusJakartaSans.ttf";
import "fonts/JetBrainsMono.ttf";

import { Theme, Icons, Icon } from "theme.slint";
import { Track, Shelf, ImportRow, PlaylistInfo, LyricWord, Status, Sources, SourceBadge, Fmt, Cover, EqBars, NavButton, IconButton, PillButton, Scrubber, TrackCard, TrackRow, ImportLine } from "parts.slint";

export { Theme, Track, Shelf, ImportRow, PlaylistInfo, LyricWord }

component SettingGroup inherits Rectangle {
    in property <string> title;
    in property <string> note;
    border-radius: Theme.r-lg;
    background: Theme.surface-1;
    VerticalLayout {
        padding: 22px; spacing: 10px;
        Text { text: root.title; font-size: 16px; font-weight: 700; color: Theme.text-primary; }
        Text { text: root.note; font-size: 13px; color: Theme.text-secondary; wrap: word-wrap; }
        Rectangle { height: 4px; }
        @children
    }
}

export component AppWindow inherits Window {
    in property <string> window-title: "vynz";
    title: window-title;
    preferred-width: 1400px;
    preferred-height: 860px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.canvas;
    default-font-family: Theme.sans;

    // Veri (Rust doldurur)
    in property <[Shelf]> shelves;
    in property <bool> home-loading: true;
    in property <[Track]> results;
    in property <bool> searching;
    in property <string> last-query;
    in property <[Track]> queue;
    in property <int> queue-index: -1;
    in property <string> toast;

    // Çalan
    in property <bool> has-now;
    in property <Track> now;
    in property <bool> playing;
    in property <bool> buffering;
    in property <float> position;
    in property <float> duration;
    in-out property <float> volume: 0.8;
    in-out property <bool> liked;

    in-out property <string> view: "home";
    in-out property <bool> drawer-open: false;
    in-out property <int> source-filter: -1;

    property <bool> compact: root.width < 1100px;
    property <length> sidebar-w: compact ? 64px : 196px;

    // Ayarlar
    in-out property <int> cache-index: 2;
    in-out property <bool> prefetch-on: true;
    in-out property <int> readahead-index: 1;
    in-out property <int> cookies-index: 0;
    in-out property <int> download-index: 1;
    in property <string> cache-usage: "…";
    callback settings-changed();
    callback clear-cache();

    // Liste aktarma
    in property <[ImportRow]> import-rows;
    in property <bool> import-busy;
    in property <int> import-done;
    in property <int> import-total;
    in property <string> import-name;
    in property <string> import-note;
    in property <[int]> import-counts: [0, 0, 0, 0];
    in-out property <int> import-filter: -1;
    callback start-import(string);
    callback import-change(int);
    callback import-save();

    // Sözler: state 0 yok, 1 yükleniyor, 2 zamanlı, 3 zamansız, 4 bulunamadı
    in property <int> lyric-state;
    in property <[string]> lyric-before;
    in property <[LyricWord]> lyric-row0;
    in property <[LyricWord]> lyric-row1;
    in property <[string]> lyric-after;
    in property <[string]> lyric-plain;
    in property <string> lyric-source;
    in property <float> lyric-offset;
    in property <image> now-blur;
    in property <bool> has-blur;
    callback lyric-shift(float);

    // Kaydedilen listeler
    in property <[PlaylistInfo]> playlists;
    in property <int> current-playlist: -1;
    in property <[Track]> playlist-tracks;
    callback open-playlist(int);
    callback play-playlist(int);
    callback delete-playlist(int);

    callback hover-shelf(int, int, bool);
    callback hover-result(int, bool);
    callback play-shelf(int, int);
    callback play-result(int);
    callback play-queue(int);
    callback search(string);
    callback seek(float);
    callback set-volume(float);
    callback toggle-play();
    callback next();
    callback prev();

    // Kapaktan türeyen ortam ışığı
    Rectangle {
        Rectangle {
            width: root.width * 1.1; height: self.width;
            x: root.width * 0.28 - self.width / 2; y: root.height * 0.18 - self.height / 2;
            background: @radial-gradient(circle, Theme.blob1 0%, transparent 58%);
            animate background { duration: 500ms; }
        }
        Rectangle {
            width: root.width * 1.2; height: self.width;
            x: root.width * 0.76 - self.width / 2; y: root.height * 0.42 - self.height / 2;
            background: @radial-gradient(circle, Theme.blob2 0%, transparent 62%);
            animate background { duration: 500ms; }
        }
        Rectangle {
            width: root.width * 0.9; height: self.width;
            x: root.width * 0.45 - self.width / 2; y: root.height * 0.88 - self.height / 2;
            background: @radial-gradient(circle, Theme.blob3 0%, transparent 55%);
            animate background { duration: 500ms; }
        }
    }

    // ---------- Kenar çubuğu ----------
    Rectangle {
        x: 0; y: 0; width: sidebar-w; height: root.height;
        background: Theme.surface-subtle;

        VerticalLayout {
            padding: 14px; padding-top: 22px; padding-bottom: Theme.player-clearance;
            spacing: 2px;
            alignment: start;

            HorizontalLayout {
                height: 28px;
                padding-left: compact ? 0 : 10px;
                alignment: compact ? center : start;
                spacing: 10px;
                Rectangle {
                    width: 10px; height: 10px; y: 9px; border-radius: 5px;
                    background: Theme.accent;
                    drop-shadow-blur: 12px; drop-shadow-color: Theme.accent;
                }
                if !compact: Text {
                    text: "vynz"; vertical-alignment: center;
                    font-family: Theme.display; font-size: 17px; font-weight: 800;
                    letter-spacing: -0.5px; color: Theme.text-primary;
                }
            }
            Rectangle { height: 24px; }
            if !compact: Text { text: "Kütüphane"; font-size: 11px; font-weight: 700; color: Theme.text-muted; x: 12px; height: 22px; }

            NavButton { icon: Icons.home; label: "Şimdi Dinle"; compact: compact; active: view == "home"; clicked => { view = "home"; } }
            NavButton { icon: Icons.search; label: "Ara"; compact: compact; active: view == "search"; clicked => { view = "search"; search-input.focus(); } }
            NavButton { icon: Icons.mic; label: "Söz Vitrini"; compact: compact; active: view == "lyrics"; clicked => { view = "lyrics"; } }
            NavButton { icon: Icons.arrows; label: "Liste Aktarma"; compact: compact; active: view == "import"; clicked => { view = "import"; } }
            NavButton { icon: Icons.radio; label: "Dinleme Odası"; compact: compact; active: view == "room"; clicked => { view = "room"; } }
            NavButton { icon: Icons.audio-lines; label: "Frekans & Profil"; compact: compact; active: view == "profile"; clicked => { view = "profile"; } }
            NavButton { icon: Icons.settings; label: "Ayarlar"; compact: compact; active: view == "settings"; clicked => { view = "settings"; } }

            Rectangle { height: 24px; }
            if !compact: Text { text: "Listelerim"; font-size: 11px; font-weight: 700; color: Theme.text-muted; x: 12px; height: 22px; }
            if !compact && playlists.length == 0: Text {
                text: "Liste Aktarma'dan ekle"; font-size: 12px; color: Theme.text-muted; x: 12px; height: 26px;
            }
            for p[i] in playlists: NavButton {
                icon: Icons.list-music; label: p.name; compact: compact;
                active: view == "playlist" && current-playlist == i;
                clicked => { root.open-playlist(i); view = "playlist"; }
            }

            Rectangle { height: 24px; }
            if !compact: Text { text: "Kaynaklar"; font-size: 11px; font-weight: 700; color: Theme.text-muted; x: 12px; height: 22px; }
            for name[i] in Sources.names: HorizontalLayout {
                height: 30px;
                padding-left: compact ? 0 : 14px;
                alignment: compact ? center : start;
                spacing: 12px;
                Rectangle {
                    width: 8px; height: 8px; y: 11px; border-radius: 4px;
                    background: Sources.colors[i];
                }
                if !compact: Text {
                    text: name + (i < 2 ? "" : " · aktarma");
                    vertical-alignment: center; font-size: 12.5px;
                    color: Theme.text-secondary;
                }
            }
        }
    }

    // ---------- Ana alan ----------
    main := Rectangle {
        x: sidebar-w; y: 0; width: root.width - sidebar-w; height: root.height;

        // Üst çubuk
        Rectangle {
            x: 0; y: 0; width: parent.width; height: 60px;
            HorizontalLayout {
                padding-left: 32px; padding-right: 32px; spacing: 10px;
                Rectangle {
                    width: Math.min(420px, main.width * 0.45);
                    height: 38px; y: 11px;
                    border-radius: 19px;
                    background: search-input.has-focus ? Theme.surface-2 : Theme.surface-1;
                    animate background { duration: Theme.micro; }
                    TouchArea { mouse-cursor: text; clicked => { search-input.focus(); } }
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 10px;
                        Icon { width: 15px; height: 15px; y: (38px - 15px) / 2; commands: Icons.search; stroke: Theme.text-muted; }
                        Rectangle {
                            horizontal-stretch: 1;
                            search-input := TextInput {
                                width: parent.width; height: parent.height;
                                vertical-alignment: center;
                                font-size: 13.5px; font-weight: 500;
                                color: Theme.text-primary;
                                single-line: true;
                                accepted => {
                                    if (self.text != "") {
                                        view = "search";
                                        root.search(self.text);
                                    }
                                }
                            }
                            if search-input.text == "": Text {
                                x: 0; height: parent.height; vertical-alignment: center;
                                text: "Şarkı, sanatçı ya da bağlantı";
                                font-size: 13.5px; color: Theme.text-muted;
                            }
                        }
                        Text { text: "Enter"; vertical-alignment: center; font-size: 11px; font-weight: 600; color: Theme.text-muted; }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    min-width: 96px; max-width: 96px; height: 34px; y: 13px;
                    border-radius: 17px;
                    background: drawer-open || q-ta.has-hover ? Theme.surface-2 : Theme.surface-1;
                    animate background { duration: Theme.micro; }
                    q-ta := TouchArea { mouse-cursor: pointer; clicked => { drawer-open = !drawer-open; } }
                    HorizontalLayout {
                        x: 14px; spacing: 6px;
                        Text { text: "Kuyruk"; vertical-alignment: center; font-size: 12.5px; font-weight: 600; color: drawer-open ? Theme.text-primary : Theme.text-secondary; }
                        Text { text: queue.length; vertical-alignment: center; font-family: Theme.mono; font-size: 11px; color: Theme.text-muted; }
                    }
                }
            }
        }

        flick := Flickable {
            x: 0; y: 60px; width: parent.width; height: parent.height - 60px;
            content-width: self.width;
            content-height: content.preferred-height;

            content := VerticalLayout {
                width: flick.width;
                padding-left: 36px; padding-right: 36px; padding-top: 12px;
                padding-bottom: Theme.player-clearance + 24px;
                spacing: 36px;

                // ===== Ana sayfa =====
                if view == "home": HorizontalLayout {
                    spacing: 32px;
                    padding-top: 12px; padding-bottom: 8px;
                    Cover {
                        width: 224px; height: 224px;
                        radius: Theme.r-lg;
                        art: now.art; has-art: has-now && now.has-art;
                        drop-shadow-blur: 56px; drop-shadow-offset-y: 28px; drop-shadow-color: #000000ad;
                    }
                    VerticalLayout {
                        alignment: end; spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            if has-now: EqBars { y: 3px; running: playing && !buffering; }
                            Text {
                                text: !has-now ? "Hoş geldin" : buffering ? "Yükleniyor" : playing ? "Şimdi Çalıyor" : "Duraklatıldı";
                                font-size: 12px; font-weight: 700; color: Theme.accent;
                            }
                        }
                        Text {
                            text: has-now ? now.title : "Ne dinlemek istersin?";
                            font-family: Theme.display; font-size: 60px; font-weight: 800;
                            letter-spacing: -2.4px; color: Theme.text-primary;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            if has-now: Text { text: now.artist; font-size: 15px; font-weight: 700; color: Theme.text-primary; }
                            if has-now && now.album != "": Text { text: "·"; font-size: 15px; color: Theme.text-secondary; }
                            if has-now: Text { text: now.album; font-size: 15px; font-weight: 500; color: Theme.text-secondary; overflow: elide; }
                            if !has-now: Text { text: "Aşağıdan bir şarkı seç ya da yukarıda ara."; font-size: 15px; color: Theme.text-secondary; }
                            if has-now: SourceBadge { y: 0px; source: now.source; }
                        }
                        Rectangle { height: 8px; }
                        HorizontalLayout {
                            spacing: 12px; alignment: start;
                            PillButton { text: "Söz Vitrinini Aç"; primary: true; enabled: has-now; clicked => { view = "lyrics"; } }
                            PillButton { text: "Ara"; clicked => { view = "search"; search-input.focus(); } }
                        }
                    }
                }

                if view == "home" && home-loading: Text {
                    text: "Önerilerin yükleniyor…"; font-size: 14px; color: Theme.text-secondary;
                }

                if view == "home": VerticalLayout {
                    spacing: 36px;
                    for shelf[si] in shelves: VerticalLayout {
                        spacing: 16px;
                        Text { text: shelf.title; font-family: Theme.display; font-size: 21px; font-weight: 700; letter-spacing: -0.5px; color: Theme.text-primary; }
                        row := Rectangle {
                            property <length> gap: 20px;
                            property <int> cols: Math.max(3, Math.floor((self.width + gap) / (176px + gap)));
                            property <length> card-w: (self.width - gap * (cols - 1)) / cols;
                            height: card-w + 52px;
                            for t[i] in shelf.items: TrackCard {
                                visible: i < row.cols;
                                x: i * (row.card-w + row.gap); y: 0;
                                width: row.card-w; height: row.card-w + 52px;
                                track: t;
                                active: has-now && t.key == now.key;
                                clicked => { root.play-shelf(si, i); }
                                hovered(on) => { root.hover-shelf(si, i, on); }
                            }
                        }
                    }
                }

                // ===== Arama =====
                if view == "search": VerticalLayout {
                    spacing: 20px;
                    Text {
                        text: last-query == "" ? "Ara" : "“" + last-query + "”";
                        font-family: Theme.display; font-size: 44px; font-weight: 800; letter-spacing: -1.6px;
                        color: Theme.text-primary; overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 8px; alignment: start;
                        PillButton { pill-height: 32px; text: "Tümü"; active: source-filter == -1; clicked => { source-filter = -1; } }
                        PillButton { pill-height: 32px; text: "YouTube Music"; active: source-filter == 0; clicked => { source-filter = 0; } }
                        PillButton { pill-height: 32px; text: "SoundCloud"; active: source-filter == 1; clicked => { source-filter = 1; } }
                        PillButton { pill-height: 32px; text: "Spotify · yakında"; enabled: false; }
                    }
                    if searching: Text { text: "Aranıyor…"; font-size: 14px; color: Theme.text-secondary; }
                    if !searching && last-query != "" && results.length == 0: Text {
                        text: "Sonuç yok. Başka bir şekilde yazmayı dene."; font-size: 14px; color: Theme.text-secondary;
                    }
                    if !searching && last-query == "": Text {
                        text: "Yukarıdaki kutuya yaz ve Enter'a bas."; font-size: 14px; color: Theme.text-secondary;
                    }
                    VerticalLayout {
                        spacing: 0px; // gizlenen satırlar boşluk bırakmasın
                        for t[i] in results: TrackRow {
                            visible: source-filter == -1 || t.source == source-filter;
                            height: self.visible ? 56px : 0px;
                            track: t; index: i;
                            playing: has-now && t.key == now.key; is-running: playing && !buffering;
                            clicked => { root.play-result(i); }
                            hovered(on) => { root.hover-result(i, on); }
                        }
                    }
                }

                // ===== Söz vitrini =====
                if view == "lyrics": Rectangle {
                    height: Math.max(520px, flick.height - Theme.player-clearance - 48px);
                    border-radius: Theme.r-xl;
                    clip: true;
                    background: Theme.surface-subtle;
                    // Önceden bulanıklaştırılmış kapak zemini
                    if has-blur && has-now: Image {
                        width: parent.width; height: parent.height;
                        source: now-blur; image-fit: cover; opacity: 0.8;
                    }
                    Rectangle { background: @linear-gradient(90deg, #090A0Dcc 0%, #090A0D66 45%, #090A0Daa 100%); }

                    HorizontalLayout {
                        padding: 44px; spacing: 56px;
                        VerticalLayout {
                            width: 280px; alignment: center; spacing: 18px;
                            Cover {
                                width: 280px; height: 280px; radius: Theme.r-lg;
                                art: now.art; has-art: has-now && now.has-art;
                                drop-shadow-blur: 56px; drop-shadow-offset-y: 28px; drop-shadow-color: #000000ad;
                            }
                            Text { text: has-now ? now.title : "Çalan yok"; font-family: Theme.display; font-size: 26px; font-weight: 800; letter-spacing: -0.8px; color: Theme.text-primary; overflow: elide; }
                            Text { text: has-now ? now.artist : ""; font-size: 14px; color: Theme.text-secondary; overflow: elide; }
                            if lyric-state == 2: HorizontalLayout {
                                spacing: 6px; alignment: start;
                                PillButton { pill-height: 30px; text: "−0.5 sn"; clicked => { root.lyric-shift(-0.5); } }
                                Text {
                                    text: (lyric-offset > 0 ? "+" : "") + Math.round(lyric-offset * 10) / 10 + " sn";
                                    vertical-alignment: center; font-family: Theme.mono; font-size: 11px; color: Theme.text-secondary; width: 56px; horizontal-alignment: center;
                                }
                                PillButton { pill-height: 30px; text: "+0.5 sn"; clicked => { root.lyric-shift(0.5); } }
                            }
                            if lyric-source != "": Text { text: "Kaynak: " + lyric-source; font-size: 11.5px; color: Theme.text-muted; }
                        }

                        // Zamanlı sözler: önceki satırlar, kelime kelime dolan satır, sonraki satırlar
                        if lyric-state == 2: VerticalLayout {
                            alignment: center; spacing: 22px;
                            for l in lyric-before: Text {
                                text: l; font-family: Theme.display; font-size: 24px; font-weight: 700;
                                letter-spacing: -0.5px; color: Theme.text-muted; overflow: elide;
                            }
                            VerticalLayout {
                                spacing: 4px;
                                for words in [lyric-row0, lyric-row1]: HorizontalLayout {
                                    spacing: 12px; alignment: start;
                                    visible: words.length > 0;
                                    height: words.length > 0 ? self.preferred-height : 0px;
                                    for w in words: Text {
                                        text: w.text;
                                        font-family: Theme.display; font-size: 44px; font-weight: 800; letter-spacing: -1.4px;
                                        color: w.state == 0 ? Theme.text-primary : w.state == 1 ? Theme.accent : Theme.text-muted;
                                        animate color { duration: 150ms; }
                                    }
                                }
                            }
                            for l in lyric-after: Text {
                                text: l; font-family: Theme.display; font-size: 24px; font-weight: 700;
                                letter-spacing: -0.5px; color: Theme.text-muted; overflow: elide;
                            }
                        }
                        if lyric-state == 3: Flickable {
                            content-height: plain.preferred-height;
                            plain := VerticalLayout {
                                spacing: 10px; alignment: start;
                                Text { text: "Bu şarkının sözleri zamanlı değil."; font-size: 12.5px; color: Theme.text-muted; }
                                for l in lyric-plain: Text { text: l; font-size: 20px; font-weight: 600; color: Theme.text-secondary; wrap: word-wrap; }
                            }
                        }
                        if lyric-state <= 1 || lyric-state == 4: VerticalLayout {
                            alignment: center;
                            Text {
                                text: !has-now ? "Bir şarkı çaldığında sözleri burada akar." : lyric-state == 4 ? "Bu şarkı için söz bulunamadı." : "Sözler getiriliyor…";
                                font-family: Theme.display; font-size: 28px; font-weight: 800; color: Theme.text-secondary;
                            }
                        }
                    }
                }

                // ===== Liste aktarma =====
                if view == "import": VerticalLayout {
                    spacing: 20px;
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Liste Aktarma"; font-family: Theme.display; font-size: 44px; font-weight: 800; letter-spacing: -1.6px; color: Theme.text-primary; }
                        Text {
                            text: "Spotify, YouTube Music ya da SoundCloud liste bağlantısını yapıştır. Spotify şarkıları YouTube Music'te (bulunamazsa SoundCloud'da) eşleştirilir.";
                            font-size: 14px; color: Theme.text-secondary; wrap: word-wrap;
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            horizontal-stretch: 1; height: 44px; border-radius: 22px;
                            background: link-input.has-focus ? Theme.surface-2 : Theme.surface-1;
                            TouchArea { mouse-cursor: text; clicked => { link-input.focus(); } }
                            link-input := TextInput {
                                x: 18px; width: parent.width - 36px; height: parent.height;
                                vertical-alignment: center; single-line: true;
                                font-size: 13.5px; color: Theme.text-primary;
                                enabled: !import-busy;
                                accepted => { if (self.text != "") { root.start-import(self.text); } }
                            }
                            if link-input.text == "": Text {
                                x: 18px; height: parent.height; vertical-alignment: center;
                                text: "https://open.spotify.com/playlist/…"; font-size: 13.5px; color: Theme.text-muted;
                            }
                        }
                        PillButton {
                            pill-height: 44px; text: import-busy ? "Aktarılıyor…" : "Aktar"; primary: !import-busy; enabled: !import-busy;
                            clicked => { if (link-input.text != "") { root.start-import(link-input.text); } }
                        }
                    }
                    Text {
                        text: "Gizli listeler ve Beğenilen Şarkılar için: listeyi geçici olarak herkese açık yap ya da Spotify'da yeni bir herkese açık listeye kopyala. Spotify'ın gömülü sayfası en fazla 100 şarkı verir.";
                        font-size: 12px; color: Theme.text-muted; wrap: word-wrap;
                    }
                    if import-busy: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: import-total > 0 ? "Eşleştiriliyor: " + import-done + " / " + import-total : "Liste okunuyor…";
                            font-size: 13px; font-weight: 600; color: Theme.text-secondary;
                        }
                        Rectangle {
                            height: 4px; border-radius: 2px; background: Theme.surface-2;
                            Rectangle {
                                x: 0; height: parent.height; border-radius: 2px; background: Theme.accent;
                                width: import-total > 0 ? parent.width * import-done / import-total : parent.width * 0.08;
                                animate width { duration: 200ms; }
                            }
                        }
                    }
                    if !import-busy && import-rows.length > 0: VerticalLayout {
                        spacing: 14px;
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: import-name; font-family: Theme.display; font-size: 22px; font-weight: 800; color: Theme.text-primary; overflow: elide; }
                                Text { text: import-note; font-size: 12.5px; color: Theme.text-secondary; overflow: elide; }
                            }
                            PillButton {
                                y: 4px; text: "Kütüphaneye kaydet (" + (import-counts[0] + import-counts[1] + import-counts[3]) + ")"; primary: true;
                                clicked => { root.import-save(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            PillButton { pill-height: 32px; text: "Tümü (" + import-rows.length + ")"; active: import-filter == -1; clicked => { import-filter = -1; } }
                            PillButton { pill-height: 32px; text: "Eşleşti (" + (import-counts[0] + import-counts[3]) + ")"; active: import-filter == 0; clicked => { import-filter = 0; } }
                            PillButton { pill-height: 32px; text: "Emin değil (" + import-counts[1] + ")"; active: import-filter == 1; clicked => { import-filter = 1; } }
                            PillButton { pill-height: 32px; text: "Bulunamadı (" + import-counts[2] + ")"; active: import-filter == 2; clicked => { import-filter = 2; } }
                        }
                        VerticalLayout {
                            spacing: 0px;
                            for r[i] in import-rows: Rectangle {
                                property <bool> shown: import-filter == -1 || r.status == import-filter || (import-filter == 0 && r.status == 3);
                                visible: shown;
                                height: shown ? 70px : 0px;
                                ImportLine {
                                    y: 0; height: 64px; line: r;
                                    change => { root.import-change(i); }
                                }
                            }
                        }
                    }
                }

                // ===== Kaydedilen liste =====
                if view == "playlist" && current-playlist >= 0 && current-playlist < playlists.length: VerticalLayout {
                    spacing: 20px;
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            horizontal-stretch: 1; spacing: 4px;
                            Text { text: "Liste"; font-size: 12px; font-weight: 700; color: Theme.accent; }
                            Text { text: playlists[current-playlist].name; font-family: Theme.display; font-size: 44px; font-weight: 800; letter-spacing: -1.6px; color: Theme.text-primary; overflow: elide; }
                            Text { text: playlists[current-playlist].count + " şarkı"; font-size: 14px; color: Theme.text-secondary; }
                        }
                        VerticalLayout {
                            alignment: end;
                            HorizontalLayout {
                                spacing: 10px;
                                PillButton { text: "Çal"; primary: true; enabled: playlist-tracks.length > 0; clicked => { root.play-playlist(0); } }
                                PillButton { text: "Sil"; clicked => { root.delete-playlist(current-playlist); view = "home"; } }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 0px;
                        for t[i] in playlist-tracks: TrackRow {
                            track: t; index: i;
                            playing: has-now && t.key == now.key; is-running: playing && !buffering;
                            clicked => { root.play-playlist(i); }
                        }
                    }
                }

                // ===== Ayarlar =====
                if view == "settings": VerticalLayout {
                    spacing: 28px;
                    Text {
                        text: "Ayarlar";
                        font-family: Theme.display; font-size: 44px; font-weight: 800; letter-spacing: -1.6px;
                        color: Theme.text-primary;
                    }

                    SettingGroup {
                        title: "Ses önbelleği";
                        note: "20 saniyeden uzun dinlenen şarkılar arka planda diske indirilir; tekrar açılışta anında başlar, internetsiz de çalar. Dolunca en uzun süredir çalınmayan silinir. Kullanılan: " + cache-usage;
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            for label[i] in ["Kapalı", "1 GB", "2 GB", "5 GB", "10 GB"]: PillButton {
                                pill-height: 32px; text: label; active: cache-index == i;
                                clicked => { cache-index = i; root.settings-changed(); }
                            }
                            Rectangle { width: 12px; }
                            PillButton { pill-height: 32px; text: "Temizle"; clicked => { root.clear-cache(); } }
                        }
                    }

                    SettingGroup {
                        title: "Arka plan indirme hızı";
                        note: "Önbelleğe indirme bu hızı aşmaz; bilgisayarda başka bir program interneti yoğun kullanıyorsa bekler, kotalı bağlantıda hiç indirmez. Çalan şarkı bu sınırdan etkilenmez.";
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            for label[i] in ["256 KB/sn", "512 KB/sn", "1 MB/sn", "Sınırsız"]: PillButton {
                                pill-height: 32px; text: label; active: download-index == i;
                                clicked => { download-index = i; root.settings-changed(); }
                            }
                        }
                    }

                    SettingGroup {
                        title: "Önceden hazırlama";
                        note: "Sıradaki şarkılar, ekrandaki ilk şarkılar ve üzerinde beklediğin şarkı arka planda hazırlanır; tıklayınca hemen başlar. Pilde ve kotalı bağlantıda yalnız sıradakiler hazırlanır.";
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            PillButton { pill-height: 32px; text: "Açık"; active: prefetch-on; clicked => { prefetch-on = true; root.settings-changed(); } }
                            PillButton { pill-height: 32px; text: "Kapalı"; active: !prefetch-on; clicked => { prefetch-on = false; root.settings-changed(); } }
                        }
                    }

                    SettingGroup {
                        title: "İleri okuma (internet kullanımı)";
                        note: "Çalan şarkının ne kadar önden indirileceği. Kısa tutulursa ilk tampondan sonra indirme çalma hızına iner ve internet başkalarına kalır.";
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            for label[i] in ["30 sn", "1 dk", "2 dk", "Sınırsız"]: PillButton {
                                pill-height: 32px; text: label; active: readahead-index == i;
                                clicked => { readahead-index = i; root.settings-changed(); }
                            }
                        }
                    }

                    SettingGroup {
                        title: "YouTube Music girişi";
                        note: "Tarayıcıdaki YouTube oturumu kullanılırsa Premium hesaplarda ses kalitesi ~260 kbps olur; girişsiz ~140 kbps.";
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            for label[i] in ["Girişsiz", "Firefox oturumu"]: PillButton {
                                pill-height: 32px; text: label; active: cookies-index == i;
                                clicked => { cookies-index = i; root.settings-changed(); }
                            }
                        }
                    }
                }

                // ===== Henüz yapılmayan ekranlar =====
                if view != "home" && view != "search" && view != "settings" && view != "import" && view != "playlist" && view != "lyrics": Rectangle {
                    height: 420px;
                    VerticalLayout {
                        alignment: center; spacing: 8px;
                        Text { text: "Bu ekran sonraki aşamada"; horizontal-alignment: center; font-family: Theme.display; font-size: 28px; font-weight: 800; color: Theme.text-primary; }
                        Text { text: "Şu an ana sayfa, arama ve oynatma hazır."; horizontal-alignment: center; font-size: 14px; color: Theme.text-secondary; }
                    }
                }
            }
        }
    }

    // ---------- Kuyruk çekmecesi ----------
    Rectangle {
        width: 340px;
        y: 72px;
        height: root.height - 72px - Theme.player-clearance + 12px;
        x: drawer-open ? root.width - self.width - 16px : root.width + 24px;
        opacity: drawer-open ? 1 : 0;
        animate x, opacity { duration: Theme.drawer-dur; easing: ease-out; }
        border-radius: Theme.r-lg;
        background: Theme.drawer;
        drop-shadow-blur: 48px; drop-shadow-offset-x: -20px; drop-shadow-color: #00000099;
        clip: true;

        TouchArea { }

        VerticalLayout {
            padding: 20px; spacing: 10px;
            HorizontalLayout {
                Text { text: "Kuyruk"; font-family: Theme.display; font-size: 17px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                IconButton { icon: Icons.x; clicked => { drawer-open = false; } }
            }
            if queue.length == 0: Text { text: "Kuyruk boş."; font-size: 13px; color: Theme.text-secondary; }
            Flickable {
                content-height: qlist.preferred-height;
                qlist := VerticalLayout {
                    spacing: 6px; alignment: start;
                    for t[i] in queue: Rectangle {
                        height: 56px; border-radius: Theme.r-sm;
                        background: i == queue-index ? Theme.surface-2 : qi-ta.has-hover ? Theme.surface-1 : Theme.surface-subtle;
                        animate background { duration: Theme.micro; }
                        qi-ta := TouchArea { mouse-cursor: pointer; clicked => { root.play-queue(i); } }
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 12px; spacing: 10px;
                            Cover { width: 38px; height: 38px; y: 9px; radius: 7px; art: t.art; has-art: t.has-art; }
                            VerticalLayout {
                                alignment: center;
                                Text { text: t.title; font-size: 13.5px; font-weight: 600; color: i == queue-index ? Theme.accent : Theme.text-primary; overflow: elide; }
                                Text { text: t.artist; font-size: 12px; color: Theme.text-secondary; overflow: elide; }
                            }
                            Text { text: t.duration > 0 ? Fmt.time(t.duration) : ""; vertical-alignment: center; font-family: Theme.mono; font-size: 11px; color: Theme.text-muted; horizontal-alignment: right; }
                        }
                    }
                }
            }
        }
    }

    // ---------- Bildirim ----------
    if toast != "": Rectangle {
        y: root.height - Theme.player-clearance - 12px;
        x: (root.width - self.width) / 2;
        width: tt.preferred-width + 32px; height: 36px;
        border-radius: 18px; background: Theme.surface-3;
        tt := Text { text: toast; font-size: 13px; font-weight: 600; color: Theme.text-primary; }
    }

    // ---------- Yüzen oynatma çubuğu ----------
    Rectangle {
        x: 20px; width: root.width - 40px;
        height: Theme.player-height;
        y: root.height - self.height - Theme.player-offset;
        border-radius: Theme.r-lg;
        background: Theme.floating;
        drop-shadow-blur: 48px; drop-shadow-offset-y: 24px; drop-shadow-color: #000000b8;

        TouchArea { }

        HorizontalLayout {
            x: 20px; width: 290px; spacing: 14px; alignment: start;
            Cover {
                width: 44px; height: 44px; y: (Theme.player-height - 44px) / 2;
                radius: Theme.r-sm;
                art: now.art; has-art: has-now && now.has-art;
            }
            VerticalLayout {
                alignment: center;
                Text { text: has-now ? now.title : "Çalan yok"; font-size: 14px; font-weight: 700; color: Theme.text-primary; overflow: elide; }
                Text { text: has-now ? now.artist : "—"; font-size: 12.5px; color: Theme.text-secondary; overflow: elide; }
            }
            IconButton {
                y: (Theme.player-height - self.height) / 2;
                icon: Icons.heart; tint: liked ? Theme.accent : Theme.text-secondary;
                enabled: has-now;
                clicked => { liked = !liked; }
            }
        }

        VerticalLayout {
            x: (parent.width - self.width) / 2; width: Math.min(560px, parent.width - 640px);
            alignment: center; spacing: 4px;
            HorizontalLayout {
                alignment: center; spacing: 10px;
                IconButton { icon: Icons.shuffle; y: 3px; enabled: false; }
                IconButton { icon: Icons.skip-back; y: 3px; enabled: has-now; clicked => { root.prev(); } }
                IconButton { icon: playing ? Icons.pause : Icons.play; primary: true; enabled: has-now; clicked => { root.toggle-play(); } }
                IconButton { icon: Icons.skip-forward; y: 3px; enabled: has-now; clicked => { root.next(); } }
                IconButton { icon: Icons.repeat; y: 3px; enabled: false; }
            }
            HorizontalLayout {
                spacing: 12px;
                Text { text: Fmt.time(position); vertical-alignment: center; font-family: Theme.mono; font-size: 11px; color: Theme.text-muted; }
                Scrubber {
                    horizontal-stretch: 1;
                    enabled: has-now && duration > 0;
                    value: duration > 0 ? position / duration : 0;
                    seek(f) => { root.seek(f * duration); }
                }
                Text { text: Fmt.time(duration); vertical-alignment: center; font-family: Theme.mono; font-size: 11px; color: Theme.text-muted; }
            }
        }

        HorizontalLayout {
            x: parent.width - self.width - 20px; width: 290px;
            alignment: end; spacing: 6px;
            IconButton { y: (Theme.player-height - self.height) / 2; icon: Icons.mic; clicked => { view = "lyrics"; } }
            IconButton { y: (Theme.player-height - self.height) / 2; icon: Icons.list-music; tint: drawer-open ? Theme.accent : Theme.text-secondary; clicked => { drawer-open = !drawer-open; } }
            Icon { y: (Theme.player-height - self.height) / 2; commands: Icons.volume; }
            Scrubber {
                width: 72px; y: (Theme.player-height - self.height) / 2;
                value: volume;
                seek(f) => { volume = f; root.set-volume(f); }
            }
        }
    }
}
