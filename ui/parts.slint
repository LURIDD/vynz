import { Theme, Icons, Icon } from "theme.slint";

export global Fmt {
    public pure function time(seconds: float) -> string {
        let s = Math.max(0, Math.floor(seconds));
        let m = Math.floor(s / 60);
        let r = Math.mod(s, 60);
        return (m < 10 ? "0" : "") + m + ":" + (r < 10 ? "0" : "") + r;
    }
}

export struct Track {
    key: string,
    title: string,
    artist: string,
    album: string,
    duration: float,
    source: int,
    art: image,
    has-art: bool,
}

// Şarkı olmayan kart: kind 0 liste, 1 albüm, 2 sanatçı, 3 ruh hâli, 4 kayıtlı liste
export struct CardUi {
    key: string,
    kind: int,
    title: string,
    sub: string,
    art: image,
    has-art: bool,
}

export struct Shelf {
    title: string,
    items: [Track],
    cards: [CardUi],
    // 0 kart rafı, 1 hızlı seçim kutucukları
    style: int,
}

// Aktarma ekranındaki satır: kaynak listedeki şarkı ve bulunan karşılığı.
// status: 0 eşleşti, 1 emin değil, 2 bulunamadı, 3 doğrudan (eşleştirme gerekmedi)
export struct ImportRow {
    key: string,
    want-title: string,
    want-artist: string,
    want-duration: float,
    title: string,
    artist: string,
    duration: float,
    source: int,
    status: int,
    score: int,
    alts: int,
    art: image,
    has-art: bool,
}

// Söz satırındaki kelime: state 0 söylendi, 1 şu an, 2 sırada; row 0/1 (uzun satır ikiye bölünür)
export struct LyricWord {
    text: string,
    // 0 söylendi, 1 şu an, 2 sırada
    state: int,
    // 0..1: varılacak dolum; Slint oraya `dur` ms'de doğrusal gider (hece hece akıcı dolum)
    fill: float,
    dur: int,
    // uzun tutulan kelime: söylenirken hafifçe büyür
    long: bool,
}

// Etkin satırın bir görsel satırı (gerçek genişliğe göre bölünmüş)
export struct LyricRow {
    words: [LyricWord],
}

// Söz satırı: state -1 geçti, 0 şu an, 1 sırada; dist = etkin satıra uzaklık
export struct LyricLine {
    text: string,
    // çeviri (kapalıysa boş)
    tr: string,
    t: float,
    state: int,
    dist: int,
}

// Söz stili: 0 Modern, 1 Klasik (serif), 2 Sade
export global LyricStyle {
    out property <[string]> families: ["Plus Jakarta Sans", "Instrument Serif", "Manrope"];
    out property <[int]> weights: [800, 400, 600];
    out property <[length]> spacing: [-1.2px, 0px, -0.4px];
    // boyut: küçük, orta, büyük (serif biraz daha büyük görünmeli)
    pure public function size(style: int, size: int) -> length {
        let base = size == 0 ? 30px : size == 2 ? 46px : 38px;
        return style == 1 ? base * 1.18 : base;
    }
}

// Karaoke kelimesi (Better Lyrics/braccato'dan esinlenerek):
// - yumuşak kenarlı dolum: metin rengi, dolum noktasında yumuşak geçişli bir degrade
// - dolum Slint'te hece sonuna kadar doğrusal akar (Rust yalnız hece sınırlarında yazar)
// - söylenen kelime hafifçe yükselir, arkasında ışıma belirir ve ~1.2 sn'de söner
// - uzun tutulan kelime söylenirken biraz büyür
export component KaraokeWord inherits Rectangle {
    in property <LyricWord> word;
    in property <string> family;
    in property <int> weight;
    in property <length> size;
    in property <length> spacing;
    in property <bool> italic;
    property <bool> current: word.state == 1;
    property <bool> sung: word.state == 0;
    property <float> f: word.fill;
    animate f { duration: root.word.dur * 1ms; easing: linear; }
    // yumuşak kenar genişliği: ~0.45 harf boyu, kısa kelimede en çok yarısı
    property <float> feather: Math.min(0.5, root.size * 0.45 / Math.max(1px, root.width));
    property <float> solid: Math.clamp(root.f * (1 + root.feather) - root.feather, 0, 1);
    property <float> clear: Math.clamp(root.f * (1 + root.feather), 0, 1);
    width: t.preferred-width;
    height: t.preferred-height;
    transform-scale: root.current && root.word.long ? 1.04 : 1.0;
    transform-origin: { x: self.width / 2, y: self.height * 0.8 };
    animate transform-scale { duration: 350ms; easing: ease-out; }

    // Işıma: kelimeyi ortalayan kare içinde dairesel, kenarlara varmadan sönen ışık (kutu gibi görünmesin)
    glow := Rectangle {
        width: Math.max(root.width, root.height) + root.size * 0.9;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: @radial-gradient(circle, #ffffff26 0%, #ffffff10 35%, #ffffff00 62%);
        opacity: 0;
    }
    // Not: Slint'in metin degradesi her harfe ayrı uygulanıyor (yarım dolu harfler bölünüyor);
    // bu yüzden dolum kırpma ile, yumuşak kenar da azalan parlaklıkta dar dilimlerle yapılır.
    property <length> lift: (root.current ? -0.05 : root.sung ? -0.02 : 0) * root.size;
    animate lift { duration: 450ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    property <length> solid-x: root.solid * root.width;
    property <length> step: (root.clear - root.solid) * root.width / 4;
    t := Text {
        x: 0; y: root.lift;
        text: root.word.text; font-family: root.family; font-weight: root.weight; font-size: root.size;
        letter-spacing: root.spacing; font-italic: root.italic;
        color: #ffffff4d;
    }
    // Dolan kısım
    Rectangle {
        x: 0; y: 0; width: root.solid-x; height: root.height;
        clip: true;
        Text {
            x: 0; y: root.lift;
            text: root.word.text; font-family: root.family; font-weight: root.weight; font-size: root.size;
            letter-spacing: root.spacing; font-italic: root.italic;
            color: #ffffff;
        }
    }
    // Yumuşak kenar: dört dilim, parlaklık azalarak (yalnız şu an söylenen kelimede)
    for i in (root.current && root.step > 0.2px ? 4 : 0): Rectangle {
        x: root.solid-x + i * root.step; y: 0; width: root.step + 0.5px; height: root.height;
        clip: true;
        Text {
            x: -parent.x; y: root.lift;
            text: root.word.text; font-family: root.family; font-weight: root.weight; font-size: root.size;
            letter-spacing: root.spacing; font-italic: root.italic;
            color: #ffffff;
            opacity: 0.78 - i * 0.2;
        }
    }
    states [
        lit when root.current: {
            glow.opacity: 1;
            in { animate glow.opacity { duration: 220ms; easing: ease-out; } }
            out { animate glow.opacity { duration: 1200ms; easing: ease-in-out; } }
        }
    ]
}

// Müzik arası: büyüyen üç nokta
export component GapDots inherits Rectangle {
    in property <float> progress;
    in property <length> size: 14px;
    width: 3 * size + 2 * size * 0.8;
    height: size;
    for i in 3: Rectangle {
        property <float> on: Math.clamp(root.progress * 3 - i, 0, 1);
        x: i * root.size * 1.8;
        width: root.size * (0.55 + 0.45 * on); height: self.width;
        y: (root.size - self.height) / 2;
        border-radius: self.width / 2;
        background: #FFFFFF;
        opacity: 0.25 + 0.75 * on;
        animate width, opacity { duration: 300ms; }
    }
}

export struct ArtistStat {
    name: string,
    label: string,
    frac: float,
}

export struct TasteGenre {
    id: string,
    label: string,
    selected: bool,
    blocked: bool,
}

export struct PlaylistInfo {
    name: string,
    count: int,
    duration-text: string,
    art: image,
    has-art: bool,
    art2: image,
    has-art2: bool,
    art3: image,
    has-art3: bool,
    art4: image,
    has-art4: bool,
    mosaic: bool,
    // Kullanıcının seçtiği özel kapak
    custom: bool,
    accent: color,
}

// Çalma listesi kapağı: 4+ kapakta 2×2 mozaik, 1–3 şarkıda tek kapak, boşta Vynz yer tutucu.
// Tüm karolar mevcut ARTS (160 px) önbelleğinden gelir; ekstra görsel üretilmez.
export component PlaylistCover inherits Rectangle {
    in property <PlaylistInfo> info;
    in property <length> radius: Theme.r-md;
    in property <length> tile-gap: 2px;
    border-radius: radius;
    clip: true;
    background: @linear-gradient(135deg, #1E1B4B 0%, #312E81 48%, #0F172A 100%);

    if info.mosaic: Rectangle {
        property <length> half: (parent.width - root.tile-gap) / 2;
        background: #00000055;
        Image { x: 0; y: 0; width: half; height: half; source: root.info.art; image-fit: cover; }
        Image { x: half + root.tile-gap; y: 0; width: half; height: half; source: root.info.art2; image-fit: cover; }
        Image { x: 0; y: half + root.tile-gap; width: half; height: half; source: root.info.art3; image-fit: cover; }
        Image { x: half + root.tile-gap; y: half + root.tile-gap; width: half; height: half; source: root.info.art4; image-fit: cover; }
    }
    if !info.mosaic && info.has-art: Image {
        width: parent.width; height: parent.height;
        source: root.info.art; image-fit: cover;
    }
    if !info.mosaic && !info.has-art: Icon {
        width: Math.max(14px, parent.width * 0.34); height: self.width;
        commands: Icons.logo; stroke: #A78BFA; stroke-width: 1.8px;
    }
}

// Kaynak rozetleri: 0 YouTube Music, 1 SoundCloud, 2 Spotify
export global Sources {
    out property <[string]> names: ["YouTube Music", "SoundCloud", "Spotify"];
    out property <[color]> colors: [#FF4E45, #FF7A1A, #1ED760];
}

export component SourceBadge inherits Rectangle {
    in property <int> source;
    height: 20px;
    width: label.preferred-width + 16px;
    border-radius: 10px;
    background: Sources.colors[source].with-alpha(0.13);
    label := Text {
        text: Sources.names[source];
        font-size: 10.5px; font-weight: 700;
        color: Sources.colors[source];
    }
}

export component Cover inherits Rectangle {
    in property <image> art;
    in property <bool> has-art;
    in property <length> radius: Theme.r-md;
    border-radius: radius;
    clip: true;
    background: @linear-gradient(135deg, Theme.surface-3 0%, Theme.surface-1 100%);
    if !has-art: Icon {
        width: Math.max(16px, parent.width * 0.3); height: self.width;
        commands: Icons.disc; stroke: Theme.text-muted;
    }
    if has-art: Image {
        width: parent.width; height: parent.height;
        source: root.art; image-fit: cover;
    }
}

// Çalan şarkı göstergesi. Her karede değil, saniyede ~4 kez güncellenir (işlemci için).
export component EqBars inherits Rectangle {
    in property <bool> running: true;
    property <int> tick;
    width: 16px;
    height: 14px;
    Timer {
        interval: 260ms;
        running: root.running;
        triggered => { root.tick += 1; }
    }
    for i in 3: Rectangle {
        x: i * 5.5px;
        width: 3px;
        border-radius: 1.5px;
        background: Theme.accent;
        property <float> phase: running
            ? Math.abs(Math.sin((root.tick * (37 + i * 23) + i * 50) * 1deg))
            : 0.35 + i * 0.2;
        height: parent.height * (0.25 + 0.75 * phase);
        y: parent.height - self.height;
    }
}

export component NavButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> badge: "";
    in property <bool> active;
    in property <bool> dot;
    in property <bool> compact;
    callback clicked;

    height: 36px;
    border-radius: Theme.r-sm;
    background: active ? Theme.surface-2 : ta.has-hover ? Theme.surface-1 : transparent;
    animate background { duration: Theme.micro; }

    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }

    HorizontalLayout {
        padding-left: compact ? (root.width - 18px) / 2 : 12px;
        padding-right: 12px;
        spacing: 12px;
        alignment: start;
        Icon {
            y: (root.height - self.height) / 2;
            commands: root.icon;
            stroke: root.active ? Theme.accent : (ta.has-hover ? Theme.text-primary : Theme.text-secondary);
        }
        if !compact: Text {
            text: root.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
            font-size: 13.5px;
            font-weight: root.active ? 700 : 600;
            color: root.active || ta.has-hover ? Theme.text-primary : Theme.text-secondary;
            overflow: elide;
        }
        if !compact && root.badge != "": Text {
            text: root.badge;
            vertical-alignment: center;
            font-family: Theme.mono;
            font-size: 11px;
            color: Theme.text-muted;
        }
    }
    if dot && !compact: Rectangle {
        x: parent.width - 18px; y: (parent.height - 6px) / 2;
        width: 6px; height: 6px; border-radius: 3px; background: Theme.live;
    }
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <color> tint: Theme.text-secondary;
    in property <bool> filled;
    callback clicked;

    width: primary ? 40px : 34px;
    height: self.width;
    border-radius: self.width / 2;
    opacity: enabled ? 1 : 0.35;
    background: primary ? (ta.has-hover && enabled ? #FFFFFF : Theme.text-primary) : (ta.has-hover && enabled ? Theme.surface-2 : transparent);
    animate background { duration: Theme.micro; }

    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } mouse-cursor: pointer; }
    Icon {
        commands: root.icon;
        stroke: root.primary ? Theme.on-primary : (ta.has-hover && !root.filled ? Theme.text-primary : root.tint);
        fill: root.filled ? root.tint : transparent;
        stroke-width: root.primary ? 1.8px : 1.4px;
    }
}

export component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <length> pill-height: 40px;
    callback clicked;

    height: pill-height;
    min-width: label.preferred-width + 36px;
    border-radius: self.height / 2;
    opacity: enabled ? 1 : 0.4;
    background: primary ? (ta.has-hover ? #FFFFFF : Theme.text-primary)
        : active ? Theme.surface-3
        : (ta.has-hover && enabled ? Theme.surface-2 : Theme.surface-1);
    animate background { duration: Theme.micro; }

    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } mouse-cursor: pointer; }
    label := Text {
        text: root.text;
        font-size: pill-height > 36px ? 13.5px : 12.5px;
        font-weight: root.primary || root.active ? 700 : 600;
        color: root.primary ? Theme.on-primary : (root.active ? Theme.text-primary : Theme.text-secondary);
    }
}

// İki aşamalı düğme: ilk tıklama "Emin misin?"e döner, 4 sn içinde ikinci tıklama onaylar.
// (PillButton'dan sonra tanımlı olmalı: Slint öne bildirim kabul etmiyor.)
export component ConfirmPill inherits HorizontalLayout {
    in property <string> text;
    in property <string> confirm-text: "Emin misin?";
    in property <length> pill-height: 32px;
    in property <bool> enabled: true;
    callback confirmed;
    property <bool> armed;
    PillButton {
        pill-height: root.pill-height;
        text: root.armed ? root.confirm-text : root.text;
        primary: root.armed;
        enabled: root.enabled;
        clicked => {
            if (root.armed) { root.armed = false; root.confirmed(); } else { root.armed = true; }
        }
    }
    Timer { interval: 4s; running: root.armed; triggered => { root.armed = false; } }
}

// İnce, üzerine gelince kalınlaşan kaydırıcı.
// Sürüklenebilir kaydırıcı.
// live: sürüklerken sürekli bildir (ses); değilse bırakınca bildir (şarkı konumu).
// wheel: fare tekerleğiyle %5 adım.
export component Scrubber inherits Rectangle {
    in property <float> value; // 0..1
    in property <bool> enabled: true;
    in property <bool> live;
    in property <bool> wheel;
    out property <bool> dragging: ta.pressed;
    // Sürüklerken gösterilen değer (zaman göstergesi için dışarı açık)
    out property <float> shown: ta.pressed ? drag : Math.clamp(value, 0, 1);
    property <float> drag;
    callback seek(float);

    height: 16px;
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.drag = Math.clamp(self.mouse-x / self.width, 0, 1);
                if (root.live) { root.seek(root.drag); }
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                root.seek(root.drag);
            }
        }
        moved => {
            if (self.pressed) {
                root.drag = Math.clamp(self.mouse-x / self.width, 0, 1);
                if (root.live) { root.seek(root.drag); }
            }
        }
        scroll-event(e) => {
            if (!root.wheel) { return reject; }
            // Yukarı tekerlek = artır
            root.seek(Math.clamp(root.value + (e.delta-y > 0 ? 0.05 : -0.05), 0, 1));
            return accept;
        }
    }
    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: ta.has-hover || ta.pressed ? 7px : 3px;
        animate height { duration: Theme.micro; }
        border-radius: self.height / 2;
        background: Theme.surface-2;
        Rectangle {
            x: 0;
            width: parent.width * root.shown;
            border-radius: parent.border-radius;
            background: Theme.accent;
        }
    }
    Rectangle {
        width: ta.pressed ? 14px : 11px; height: self.width; border-radius: self.width / 2;
        x: track.width * root.shown - self.width / 2;
        y: (parent.height - self.height) / 2;
        background: #FFFFFF;
        opacity: ta.has-hover || ta.pressed ? 1 : 0;
        animate opacity, width { duration: Theme.micro; }
        drop-shadow-blur: 6px; drop-shadow-color: #00000080; drop-shadow-offset-y: 2px;
    }
}

export component TrackCard inherits Rectangle {
    in property <Track> track;
    in property <bool> active;
    callback clicked;
    callback hovered(bool);
    callback menu(length, length);

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
        changed has-hover => { root.hovered(self.has-hover); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    Rectangle {
        x: -10px; width: parent.width + 20px; height: parent.height + 10px;
        y: (ta.has-hover ? -4px : 0px) - 10px;
        animate y, background { duration: Theme.card; easing: ease-out; }
        border-radius: Theme.r-md;
        background: ta.has-hover ? Theme.surface-1 : transparent;
        drop-shadow-blur: 36px;
        drop-shadow-offset-y: 18px;
        drop-shadow-color: ta.has-hover ? #0000008c : transparent;
        animate drop-shadow-color { duration: Theme.card; }
    }

    Rectangle {
        y: ta.has-hover ? -4px : 0px;
        animate y { duration: Theme.card; easing: ease-out; }
        VerticalLayout {
            spacing: 12px;
            alignment: start;
            Cover {
                art: root.track.art; has-art: root.track.has-art;
                width: root.width; height: root.width;
                drop-shadow-blur: 24px; drop-shadow-offset-y: 10px; drop-shadow-color: #00000059;
                Rectangle {
                    width: 38px; height: 38px; border-radius: 19px;
                    x: parent.width - 48px;
                    y: parent.height - (ta.has-hover || root.active ? 48px : 42px);
                    opacity: ta.has-hover || root.active ? 1 : 0;
                    animate opacity, y { duration: Theme.card; easing: ease-out; }
                    background: Theme.text-primary;
                    drop-shadow-blur: 20px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
                    if !root.active: Icon { width: 16px; height: 16px; x: 12px; commands: Icons.play; stroke: Theme.on-primary; fill: Theme.on-primary; }
                    if root.active: EqBars { running: true; }
                }
            }
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: root.track.title; overflow: elide;
                    font-size: 14.5px; font-weight: 700;
                    color: root.active ? Theme.accent : Theme.text-primary;
                }
                Text {
                    text: root.track.artist; overflow: elide;
                    font-size: 13px; color: Theme.text-secondary;
                }
            }
        }
    }
}

export component TrackRow inherits Rectangle {
    in property <Track> track;
    in property <int> index;
    in property <bool> playing;
    in property <bool> is-running;
    callback clicked;
    callback hovered(bool);
    callback menu(length, length);

    height: 56px;
    border-radius: Theme.r-sm;
    background: playing || ta.has-hover ? Theme.surface-1 : transparent;
    animate background { duration: Theme.micro; }

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
        changed has-hover => { root.hovered(self.has-hover); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: 14px; padding-right: 14px; spacing: 14px;
        Rectangle {
            width: 24px;
            if root.playing: EqBars { x: 0; running: root.is-running; }
            if !root.playing: Text {
                x: 0;
                text: (root.index < 9 ? "0" : "") + (root.index + 1);
                font-family: Theme.mono; font-size: 12px; color: Theme.text-muted;
                vertical-alignment: center;
            }
        }
        Cover {
            width: 40px; height: 40px; y: 8px;
            radius: 8px;
            art: root.track.art; has-art: root.track.has-art;
        }
        VerticalLayout {
            alignment: center; spacing: 1px;
            horizontal-stretch: 2;
            Text {
                text: root.track.title; overflow: elide;
                font-size: 14px; font-weight: root.playing ? 700 : 600;
                color: root.playing ? Theme.accent : Theme.text-primary;
            }
            Text { text: root.track.artist; font-size: 12.5px; color: Theme.text-secondary; overflow: elide; }
        }
        Text {
            horizontal-stretch: 1;
            text: root.track.album; overflow: elide;
            horizontal-alignment: left; vertical-alignment: center; font-size: 13.5px;
            color: ta.has-hover || root.playing ? Theme.text-primary : Theme.text-secondary;
        }
        Rectangle {
            width: 110px;
            SourceBadge { x: 0; source: root.track.source; }
        }
        Text {
            width: 52px; horizontal-alignment: right; vertical-alignment: center;
            text: root.track.duration > 0 ? Fmt.time(root.track.duration) : "";
            font-family: Theme.mono; font-size: 12px; color: Theme.text-muted;
        }
    }
}

export global Status {
    out property <[string]> names: ["Eşleşti", "Emin değil", "Bulunamadı", "Hazır"];
    out property <[color]> colors: [#34D399, #FBBF24, #FB7185, #34D399];
}

export component ImportLine inherits Rectangle {
    in property <ImportRow> line;
    callback change();
    // Kaydetmeden önce satırı aktarılan listeden çıkar
    callback remove();

    height: 64px;
    border-radius: Theme.r-md;
    background: ta.has-hover ? Theme.surface-2 : Theme.surface-1;
    animate background { duration: Theme.micro; }
    ta := TouchArea { }

    HorizontalLayout {
        padding-left: 16px; padding-right: 14px; spacing: 14px;
        // Kaynak listedeki şarkı
        VerticalLayout {
            alignment: center; horizontal-stretch: 1;
            Text { text: root.line.want-title; font-size: 13.5px; font-weight: 700; color: Theme.text-primary; overflow: elide; }
            Text {
                text: root.line.want-artist + (root.line.want-duration > 0 ? " · " + Fmt.time(root.line.want-duration) : "");
                font-size: 12px; color: Theme.text-secondary; overflow: elide;
            }
        }
        Icon { y: (root.height - self.height) / 2; width: 16px; height: 16px; commands: Icons.arrows; stroke: Theme.text-muted; }
        // Bulunan karşılık
        if root.line.status != 2: HorizontalLayout {
            horizontal-stretch: 1; spacing: 10px;
            Cover { width: 40px; height: 40px; y: 12px; radius: 8px; art: root.line.art; has-art: root.line.has-art; }
            VerticalLayout {
                alignment: center;
                Text { text: root.line.title; font-size: 13.5px; font-weight: 600; color: Theme.text-primary; overflow: elide; }
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: root.line.artist + (root.line.duration > 0 ? " · " + Fmt.time(root.line.duration) : ""); font-size: 12px; color: Theme.text-secondary; overflow: elide; }
                }
            }
        }
        if root.line.status == 2: Text {
            horizontal-stretch: 1; vertical-alignment: center;
            text: "Karşılığı bulunamadı"; font-size: 13px; color: Status.colors[2];
        }
        Rectangle {
            width: 120px;
            Rectangle {
                x: 0; height: 22px; width: st.preferred-width + 18px; border-radius: 11px;
                background: Status.colors[root.line.status].with-alpha(0.13);
                st := Text {
                    text: Status.names[root.line.status] + (root.line.status < 2 ? " %" + root.line.score : "");
                    font-size: 11px; font-weight: 700; color: Status.colors[root.line.status];
                }
            }
        }
        Rectangle {
            width: 84px;
            if root.line.alts > 1: PillButton {
                x: 0; y: (root.height - self.height) / 2; pill-height: 30px; text: "Değiştir";
                clicked => { root.change(); }
            }
        }
        IconButton {
            y: (root.height - self.height) / 2;
            icon: Icons.trash; tint: Theme.text-muted;
            clicked => { root.remove(); }
        }
    }
}

// Hızlı seçim kutucuğu: küçük kapak + ad, tıklayınca çalar.
export component Tile inherits Rectangle {
    in property <Track> track;
    in property <bool> active;
    callback clicked;
    callback hovered(bool);
    callback menu(length, length);

    height: 60px;
    border-radius: Theme.r-md;
    clip: true;
    background: ta.has-hover ? Theme.surface-2 : Theme.surface-1;
    animate background { duration: Theme.micro; }
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
        changed has-hover => { root.hovered(self.has-hover); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        spacing: 12px; padding-right: 12px;
        Cover { width: 60px; height: 60px; radius: 0; art: root.track.art; has-art: root.track.has-art; }
        VerticalLayout {
            alignment: center;
            Text { text: root.track.title; font-size: 13.5px; font-weight: 700; color: root.active ? Theme.accent : Theme.text-primary; overflow: elide; }
            Text { text: root.track.artist; font-size: 12px; color: Theme.text-secondary; overflow: elide; }
        }
        if root.active: EqBars { y: 23px; running: true; }
    }
}

// Sağ tık menüsü satırı
export component MenuItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    callback clicked;
    height: 36px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.surface-2 : transparent;
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
    HorizontalLayout {
        padding-left: 10px; padding-right: 12px; spacing: 10px;
        Icon { y: 9px; width: 18px; height: 18px; commands: root.icon; stroke: ta.has-hover ? Theme.text-primary : Theme.text-secondary; }
        Text { text: root.text; vertical-alignment: center; font-size: 13px; font-weight: 600; color: Theme.text-primary; }
    }
}

// Liste / albüm / sanatçı kartı (sanatçı yuvarlak)
export component CardTile inherits Rectangle {
    in property <CardUi> card;
    callback clicked;
    callback hovered(bool);
    property <bool> round: card.kind == 2;

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
        changed has-hover => { root.hovered(self.has-hover); }
    }
    Rectangle {
        x: -10px; width: parent.width + 20px; height: parent.height + 10px;
        y: (ta.has-hover ? -4px : 0px) - 10px;
        animate y, background { duration: Theme.card; easing: ease-out; }
        border-radius: Theme.r-md;
        background: ta.has-hover ? Theme.surface-1 : transparent;
        drop-shadow-blur: 36px; drop-shadow-offset-y: 18px;
        drop-shadow-color: ta.has-hover ? #0000008c : transparent;
        animate drop-shadow-color { duration: Theme.card; }
    }
    Rectangle {
        y: ta.has-hover ? -4px : 0px;
        animate y { duration: Theme.card; easing: ease-out; }
        VerticalLayout {
            spacing: 10px; alignment: start;
            Cover {
                art: root.card.art; has-art: root.card.has-art;
                width: root.width; height: root.width;
                radius: root.round ? root.width / 2 : Theme.r-md;
                drop-shadow-blur: 24px; drop-shadow-offset-y: 10px; drop-shadow-color: #00000059;
            }
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: root.card.title; overflow: elide; font-size: 14.5px; font-weight: 700; color: Theme.text-primary;
                    horizontal-alignment: root.round ? center : left;
                }
                Text {
                    text: root.card.sub; overflow: elide; font-size: 12.5px; color: Theme.text-secondary;
                    horizontal-alignment: root.round ? center : left;
                }
            }
        }
    }
}

// Ruh hâli / tür kutucuğu: sıraya göre renk
export component MoodTile inherits Rectangle {
    in property <CardUi> card;
    in property <int> index;
    callback clicked;
    callback hovered(bool);
    property <[color]> palette: [#E76F51, #2A9D8F, #8E7DBE, #E9C46A, #457B9D, #F4A261, #D1495B, #43AA8B, #6D597A, #EF8354, #4D908E, #B5838D];
    property <color> c: palette[Math.mod(index, 12)];

    border-radius: Theme.r-md;
    clip: true;
    background: @linear-gradient(135deg, c 0%, c.darker(0.6) 100%);
    opacity: ta.has-hover ? 1 : 0.9;
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
        changed has-hover => { root.hovered(self.has-hover); }
    }
    Text {
        x: 16px; y: parent.height - self.height - 12px;
        width: parent.width - 32px;
        text: root.card.title; font-family: Theme.display; font-size: 16px; font-weight: 800;
        color: #FFFFFF; overflow: elide;
    }
    Rectangle {
        x: parent.width - 34px; y: -10px; width: 52px; height: 52px; border-radius: 26px;
        background: #ffffff1f;
    }
}

// Rafın sağında/solunda beliren ok
export component PagerArrow inherits Rectangle {
    in property <bool> left;
    in property <bool> shown;
    out property <bool> hovering: ta.has-hover;
    callback clicked;
    width: 40px; height: 40px; border-radius: 20px;
    background: ta.has-hover ? #FFFFFF : Theme.floating;
    opacity: shown ? 1 : 0;
    animate opacity, background { duration: Theme.micro; }
    drop-shadow-blur: 18px; drop-shadow-offset-y: 6px; drop-shadow-color: #00000099;
    ta := TouchArea { enabled: root.shown; mouse-cursor: pointer; clicked => { root.clicked(); } }
    Icon {
        commands: root.left ? Icons.chevron-left : Icons.chevron-right;
        stroke: ta.has-hover ? Theme.on-primary : Theme.text-primary; stroke-width: 2px;
    }
}
